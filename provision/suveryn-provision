job = docs.accept_upload(io.BytesIO(sys.stdin.buffer.read()), "provisioning-check.pdf", "provisioning-check")
for _ in range(600):
    j = docs.job(job.id, "provisioning-check")
    if j.status not in ("queued", "processing"):
        break
    time.sleep(1)
result = {"state": docs.state, "status": j.status, "pages": j.pages, "error": j.error, "warnings": [w["kind"] for w in j.warnings]}
