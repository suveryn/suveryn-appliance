def verify(public_url: str | None) -> bool:
    ok = True

    def result(name: str, passed: bool, detail: str) -> None:
        nonlocal ok
        ok &= passed
        print(f"   {'OK  ' if passed else 'FAIL'} {name}: {detail}", flush=True)

    step("Verify")
    gw = read_env(ETC / "gateway.env")
    # PostgreSQL: the gateway's own role reaches its database, and pgvector is there.
    q = subprocess.run([RUNUSER, "-u", "suveryn", "--", "psql", gw.get("SUVERYN_DATABASE_URL", ""), "-tAc",
                        "SELECT extversion FROM pg_extension WHERE extname = 'vector'"], capture_output=True, text=True)
    result("PostgreSQL", q.returncode == 0 and q.stdout.strip() != "",
           f"database suveryn as role suveryn, pgvector {q.stdout.strip() or '?'}")
    # llama-server: the default model loaded and answering.
    wait_for(lambda: http("http://127.0.0.1:8080/health")[0] == 200, "llama-server", 300)
    status, body = http("http://127.0.0.1:8080/v1/models")
    ids = [m.get("id") for m in json.loads(body or b"{}").get("data", [])] if status == 200 else []
    default = gw.get("SUVERYN_LLM_DEFAULT_MODEL")
    status, body = http("http://127.0.0.1:8080/v1/chat/completions", {"Content-Type": "application/json"}, json.dumps(
        {"model": default, "messages": [{"role": "user", "content": "Antwoord met één woord: ja"}], "max_tokens": 5}).encode(),
        timeout=180)
    result("llama-server", status == 200 and default in ids, f"models {ids}, default {default} answered ({status})")
    # Keycloak: ready, the realm with its production settings and the sūveryn theme (through the admin API,
    # and the realm's discovery as the reverse proxy will ask it, https in X-Forwarded-Proto).
    wait_for(lambda: 200 in (http("http://127.0.0.1:9000/idp/health/ready")[0], http("http://127.0.0.1:9000/health/ready")[0]),
             "Keycloak", 180)
    kc = read_env(ETC / "keycloak.env")
    status, body = http("http://127.0.0.1:8180/idp/realms/master/protocol/openid-connect/token", data=(
        "grant_type=password&client_id=admin-cli&username=suveryn-setup&password="
        + urllib.parse.quote(kc.get("KC_BOOTSTRAP_ADMIN_PASSWORD", ""))).encode())
    token = json.loads(body or b"{}").get("access_token") if status == 200 else None
    realm = {}
    if token:
        s, b = http("http://127.0.0.1:8180/idp/admin/realms/suveryn", {"Authorization": f"Bearer {token}"})
        realm = json.loads(b) if s == 200 else {}
    host = (public_url or gw.get("SUVERYN_PUBLIC_URL", "")).split("://", 1)[-1].rstrip("/")
    s, b = http("http://127.0.0.1:8180/idp/realms/suveryn/.well-known/openid-configuration",
                {"X-Forwarded-Proto": "https", "X-Forwarded-Host": host})
    issuer = json.loads(b).get("issuer") if s == 200 else None
    result("Keycloak", bool(realm) and realm.get("sslRequired") == "all" and realm.get("loginTheme") == "suveryn"
           and realm.get("eventsExpiration") == 180 * 86400 and issuer == gw.get("SUVERYN_OIDC_ISSUER"),
           f"realm suveryn: sslRequired {realm.get('sslRequired')}, theme {realm.get('loginTheme')}, events "
           f"{(realm.get('eventsExpiration') or 0) // 86400} days, issuer matches the gateway's: "
           f"{issuer == gw.get('SUVERYN_OIDC_ISSUER')}")
    # The reader sandbox: set, never bypassed, and a document really read through it.
    sandboxed = gw.get("SUVERYN_EXTRACT_WRAPPER") == READER_WRAPPER and "SUVERYN_EXTRACT_UNSANDBOXED" not in gw
    # On the CPU: the running services hold the GPU; the sandbox path is the same either way.
    env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", **gw, "SUVERYN_RAG_DEVICE": "cpu", "CUDA_VISIBLE_DEVICES": ""}
    r = subprocess.run([RUNUSER, "-u", "suveryn", "--", str(CORE / ".venv" / "bin" / "python"), "-c", READ_CHECK],
                       input=test_pdf(), capture_output=True, env=env, timeout=900)
    try:
        read = json.loads(r.stdout.decode().strip().splitlines()[-1])
    except (IndexError, ValueError):
        read = {"error": r.stderr.decode()[-400:]}
    result("Reader sandbox", sandboxed and read.get("status") in ("ready", "needs_review") and read.get("pages") == 1,
           f"wrapper set and required: {sandboxed}; a test PDF uploaded as the gateway's user: {read}")
    # The gateway service: up, and its own view of the services.
    wait_for(lambda: http("http://127.0.0.1:8000/health")[0] in (200, 503), "gateway", 120)
    s, b = http("http://127.0.0.1:8000/health")
    h = json.loads(b) if b else {}
    parts = {k: (h.get(k) or {}).get("status") for k in ("backend", "documents", "history", "usage", "auth")}
    result("Gateway", s == 200 and parts["documents"] == "ready" and parts["history"] == "ready",
           f"/health {s}: {parts}")
    result("Sign-in configured", parts.get("auth") == "ready", f"the gateway reaches Keycloak through https: {parts.get('auth')}")
    host = (public_url or gw.get("SUVERYN_PUBLIC_URL", "")).split("://", 1)[-1].rstrip("/")
    for name, passed, detail in verify_proxy(host, kc.get("KC_BOOTSTRAP_ADMIN_PASSWORD", "")):
        result(name, passed, detail)
    mode = subprocess.run([OPT / "bin" / "suveryn-network-mode", "get"], capture_output=True, text=True).stdout.strip()
    result("Network mode", mode != "unknown", mode)
    return ok


