def tls_context(maximum: ssl.TLSVersion | None = None) -> ssl.SSLContext:
    ctx = ssl.create_default_context(cafile="/etc/ssl/certs/ca-certificates.crt")
    if maximum:
        with warnings.catch_warnings():  # offering an old protocol on purpose, to see it refused
            warnings.simplefilter("ignore", DeprecationWarning)
            ctx.minimum_version = ssl.TLSVersion.MINIMUM_SUPPORTED
            ctx.maximum_version = maximum
        ctx.set_ciphers("ALL:@SECLEVEL=0")
    return ctx


def tls_handshake(host: str, maximum: ssl.TLSVersion | None = None) -> str | None:
    """The protocol a handshake ends with, or None if the server refuses it."""
    try:
        with socket.create_connection((host, 443), timeout=10) as raw, \
                tls_context(maximum).wrap_socket(raw, server_hostname=host) as tls_sock:
            return tls_sock.version()
    except (ssl.SSLError, OSError):
        return None


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def verify_proxy(host: str, admin_password: str) -> list[tuple[str, bool, str]]:
    """The proxy as a browser on the office network sees it, then sign-in and an upload end to end."""
    out = []
    base = f"https://{host}"
    ctx = tls_context()
    # TLS: 1.2 and 1.3 accepted, 1.1 refused, the certificate valid for the name; http redirects.
    modern, old = tls_handshake(host), tls_handshake(host, ssl.TLSVersion.TLSv1_1)
    out.append(("TLS", modern in ("TLSv1.3", "TLSv1.2") and old is None,
                f"handshake {modern}, certificate verified for {host}; TLS 1.1 refused: {old is None}"))
    plain = urllib.request.build_opener(_NoRedirect)
    try:
        plain.open(f"http://{host}/", timeout=10)
        redirect = None
    except urllib.error.HTTPError as e:
        redirect = (e.code, e.headers.get("Location"))
    out.append(("HTTP to HTTPS", redirect == (301, f"{base}/"), f"http://{host}/ → {redirect}"))
    # Headers on the UI, the API (also an error answer) and Keycloak's pages.
    opener = urllib.request.build_opener(urllib.request.HTTPSHandler(context=ctx), _NoRedirect)

    def get(path: str):
        try:
            r = opener.open(f"{base}{path}", timeout=20)
            return r.status, {k.lower(): v for k, v in r.headers.items()}
        except urllib.error.HTTPError as e:
            return e.code, {k.lower(): v for k, v in e.headers.items()}

    problems = []
    for path, expect_status, csp in (("/", 200, UI_CSP), ("/health", 200, UI_CSP), ("/v1/documents", 401, UI_CSP),
                                     ("/idp/realms/suveryn/.well-known/openid-configuration", 200, None)):
        status, h = get(path)
        if status != expect_status:
            problems.append(f"{path}: status {status}")
        for k, v in COMMON_HEADERS.items():
            if h.get(k) != v:
                problems.append(f"{path}: {k} {h.get(k)!r}")
        if csp and h.get("content-security-policy") != csp:
            problems.append(f"{path}: CSP {h.get('content-security-policy')!r}")
        if "server" in h and "/" in h["server"]:
            problems.append(f"{path}: server version shown ({h['server']})")
    out.append(("Security headers", not problems,
                "HSTS, nosniff, no-referrer, COOP on the UI, the API and Keycloak; the UI's strict CSP on the UI and API; "
                "no server version" if not problems else "; ".join(problems)))
    docs = [get(path)[0] for path in ("/docs", "/redoc", "/openapi.json")]
    out.append(("API docs off", docs == [404, 404, 404], f"/docs, /redoc, /openapi.json: {docs}"))
    out += [verify_sign_in(base, ctx, admin_password)]
    return out


def verify_sign_in(base: str, ctx: ssl.SSLContext, admin_password: str) -> tuple[str, bool, str]:
    """Sign in through the proxy as a temporary user, upload a fictional PDF over HTTPS, read it, delete it."""
    status, body = http("http://127.0.0.1:8180/idp/realms/master/protocol/openid-connect/token", data=(
        "grant_type=password&client_id=admin-cli&username=suveryn-setup&password=" + urllib.parse.quote(admin_password)).encode())
    if status != 200:
        return "Sign-in and upload over HTTPS", False, f"no admin token ({status})"
    auth = {"Authorization": f"Bearer {json.loads(body)['access_token']}", "Content-Type": "application/json"}
    users = "http://127.0.0.1:8180/idp/admin/realms/suveryn/users"
    name, password = f"verify-{uuid.uuid4().hex[:8]}", secrets.token_urlsafe(18)
    http(users, auth, json.dumps({"username": name, "enabled": True, "email": f"{name}@provision.invalid",
                                  "emailVerified": True, "firstName": "Provisioning", "lastName": "Check",
                                  "credentials": [{"type": "password", "value": password, "temporary": False}]}).encode())
    status, body = http(f"{users}?username={name}&exact=true", auth)
    user_id = (json.loads(body) or [{}])[0].get("id") if status == 200 else None
    jar = CookieJar()
    browser = urllib.request.build_opener(urllib.request.HTTPSHandler(context=ctx), urllib.request.HTTPCookieProcessor(jar))
    origin = {"Origin": base}
    steps = []
    try:
        page = browser.open(f"{base}/auth/login?return_to=/", timeout=30).read().decode()
        action = re.search(r'<form[^>]*id="kc-form-login"[^>]*action="([^"]+)"', page) or \
            re.search(r'<form[^>]*action="([^"]+)"[^>]*id="kc-form-login"', page)
        steps.append(f"login page {'found' if action else 'not found'}")
        landed = browser.open(unescape(action.group(1)), data=urllib.parse.urlencode(
            {"username": name, "password": password, "credentialId": ""}).encode(), timeout=30)
        me = json.loads(browser.open(f"{base}/auth/me", timeout=30).read())
        steps.append(f"signed in as {me.get('username')}, back at {urllib.parse.urlsplit(landed.url).path}")
        boundary = uuid.uuid4().hex
        form = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"provisioning-check.pdf\"\r\n"
                f"Content-Type: application/pdf\r\n\r\n").encode() + test_pdf() + f"\r\n--{boundary}--\r\n".encode()
        job = json.loads(browser.open(urllib.request.Request(f"{base}/v1/documents", data=form, headers={
            **origin, "Content-Type": f"multipart/form-data; boundary={boundary}"}), timeout=60).read())
        for _ in range(300):
            job = json.loads(browser.open(f"{base}/v1/documents/jobs/{job['id']}", timeout=30).read())
            if job["status"] not in ("queued", "processing"):
                break
            time.sleep(1)
        steps.append(f"uploaded over HTTPS: {job['status']}, {job.get('pages')} page(s)")
        if job.get("document_id"):
            browser.open(urllib.request.Request(f"{base}/v1/documents/{job['document_id']}?conversations=delete",
                                                headers=origin, method="DELETE"), timeout=30)
            steps.append("deleted")
        browser.open(urllib.request.Request(f"{base}/auth/logout", headers=origin, method="POST"), timeout=30)
        ok = me.get("username") == name and job["status"] == "ready" and job.get("pages") == 1
    except (urllib.error.URLError, OSError, ValueError, KeyError, AttributeError) as e:
        steps.append(f"failed: {type(e).__name__} {getattr(e, 'code', '')} {str(e)[:120]}")
        ok = False
    finally:
        if user_id:
            urllib.request.urlopen(urllib.request.Request(f"{users}/{user_id}", headers=auth, method="DELETE"), timeout=10)
            steps.append("test user removed")
    return "Sign-in and upload over HTTPS", ok, "; ".join(steps)


# ---------------------------------------------------------------------------- main
FIRST_BOOT_DONE = VAR / ".first-boot-done"


def image() -> None:
    """Everything that is the same for every office: built into the appliance image (needs network)."""
    users()
    packages()
    suveryn_core()
    llama_server()
    keycloak_software()
    reader_sandbox()
    chat_ui()
    for name in ("suveryn-headers.conf", "suveryn-csp.conf"):
        shutil.copyfile(REPO / "reverse-proxy" / name, Path("/etc/nginx/snippets") / name)


def first_boot(a: argparse.Namespace, staging: bool) -> None:
    """Everything unique to this box and this office: never in the image (secrets, names, certificates)."""
    step("GPU licence check")
    may, message = gpu_verdict(gpu_names(), a.site)
    print(f"   {'!!' if 'TEST' in message or not may else '  '} {message}", flush=True)
    if not may:
        fail("stopped at the GPU licence check")
    if not a.public_url or not a.public_url.startswith("https://"):
        fail("--public-url must be https (the realm requires TLS everywhere)")
    network_mode(a.network_mode)
    mode = subprocess.run([OPT / "bin" / "suveryn-network-mode", "get"], capture_output=True, text=True).stdout.strip()
    if not staging:  # the appliance itself; a test pod (install) has no firewall of its own
        firewall(mode)
        updates(mode)
    db_url, keycloak_pw = postgres()
    llms = llm_models(a.models_from, mode, staging)
    oidc = keycloak(a.public_url, keycloak_pw)
    reader = READER_SETTINGS
    host = a.public_url.split("://", 1)[1].rstrip("/")
    tls(host, a.tls_cert, a.tls_key)
    reverse_proxy(host)
    configure(db_url, oidc, reader, llms)
    step("Starting the services")
    services("start")
    ok = verify(a.public_url)
    if ok and not staging:
        FIRST_BOOT_DONE.write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ\n", time.gmtime()))
    sys.exit(0 if ok else 1)


def first_boot_config(path: Path) -> dict[str, str]:
    """first-boot.env, written by the installer before the first start (KEY=value, see image/README.md)."""
    values = read_env(path)
    unknown = set(values) - {"PUBLIC_URL", "NETWORK_MODE", "SITE", "MODELS_FROM", "TLS_CERT", "TLS_KEY"}
    if unknown:
        fail(f"unknown setting in {path}: {', '.join(sorted(unknown))}")
    return values


def main() -> None:
    ap = argparse.ArgumentParser(prog="suveryn-provision", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="command", required=True)

    def office_args(p: argparse.ArgumentParser, required: bool) -> None:
        p.add_argument("--public-url", required=required, help="the https URL people will open sūveryn at")
        p.add_argument("--network-mode", choices=["connected", "outbound-blocked", "air-gapped"],
                       help="the installation's network mode once in use (asked when omitted on a console)")
        p.add_argument("--site", choices=["on-premise", "datacenter", "test"],
                       help="where this machine runs; required with a GeForce card")
        p.add_argument("--models-from", type=Path, help="a folder (e.g. physical media) holding the LLM files")
        p.add_argument("--tls-cert", type=Path, help="the office's certificate for the public name (PEM, full chain)")
        p.add_argument("--tls-key", type=Path, help="its private key (PEM); without both, a local CA issues one")

    office_args(sub.add_parser("install", help="image and first-boot in one go (a test or staging machine)"), True)
    sub.add_parser("image", help="build-time steps: everything the same for every office (needs network)")
    f = sub.add_parser("first-boot", help="first-boot steps on the office's machine: names, secrets, models, start")
    office_args(f, False)
    f.add_argument("--config", type=Path, help="first-boot.env: PUBLIC_URL, NETWORK_MODE, SITE, MODELS_FROM, TLS_CERT, TLS_KEY")
    sub.add_parser("verify", help="check every service, end to end")
    s = sub.add_parser("services", help="start, stop or show the services (systemd, or the test runner)")
    s.add_argument("action", choices=["start", "stop", "status"])
    a = ap.parse_args()
    if os.geteuid() != 0:
        fail("run as root")
    if a.command == "services":
        services(a.action)
        return
    if a.command == "verify":
        sys.exit(0 if verify(None) else 1)
    if a.command == "image":
        image()
        return
    if a.command == "first-boot":
        if FIRST_BOOT_DONE.exists():
            note(f"first boot already done ({FIRST_BOOT_DONE.read_text().strip()}); nothing to do")
            return
        if a.config:
            c = first_boot_config(a.config)
            a.public_url = a.public_url or c.get("PUBLIC_URL")
            a.network_mode = a.network_mode or c.get("NETWORK_MODE")
            a.site = a.site or c.get("SITE")
            for key, attr in (("MODELS_FROM", "models_from"), ("TLS_CERT", "tls_cert"), ("TLS_KEY", "tls_key")):
                if not getattr(a, attr) and c.get(key):
                    setattr(a, attr, Path(c[key]))
        first_boot(a, staging=False)
    image()
    first_boot(a, staging=True)


if __name__ == "__main__":
    main()
