# Keycloak in production mode, on loopback behind the appliance's TLS reverse proxy (keycloak.conf).
[Unit]
Description=Keycloak (sūveryn sign-in)
After=network.target postgresql.service
# Wants, not Requires: with Requires, stopping PostgreSQL stopped Keycloak, and starting PostgreSQL didn't
# bring it back, so no one could sign in (round 2, finding 2). Keycloak outlives a stopped database: its
# sign-ins fail meanwhile and work again within about ten seconds of the database's return (checked on
# Keycloak 26.8 with PostgreSQL 16).
Wants=postgresql.service
# Should it stop on its own anyway, it starts again, for as long as it takes.
StartLimitIntervalSec=0

# On the read-only system the unit is enabled in the image and starts once first boot has written
# its settings (#47).
ConditionPathExists=/etc/suveryn/keycloak.env

[Service]
User=keycloak
Group=keycloak
EnvironmentFile=/etc/suveryn/keycloak.env
# Java 21, which this Keycloak release is checked on, also where an Ubuntu has newer Java (#57).
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# The network mode: the login page shows its "Air-gapped" badge only when it is true (keycloak/theme).
EnvironmentFile=-/etc/suveryn/network-mode.env
# Keycloak keeps gzip copies of the theme's files under data/tmp/kc-gzip-cache/<its own resource version>,
# which doesn't change with the theme: after a new theme every browser got the old stylesheet (VM check of
# 29 October, round 3, finding 1). Emptied at each start; Keycloak makes the copies again on first request.
ExecStartPre=/usr/bin/rm -rf /opt/keycloak/data/tmp/kc-gzip-cache
ExecStart=/opt/keycloak/bin/kc.sh start --optimized
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
