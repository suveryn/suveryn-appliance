# Keycloak in production mode, on loopback behind the appliance's TLS reverse proxy (keycloak.conf).
[Unit]
Description=Keycloak (sūveryn sign-in)
After=network.target postgresql.service
Requires=postgresql.service

# On the read-only system the unit is enabled in the image and starts once first boot has written
# its settings (#47).
ConditionPathExists=/etc/suveryn/keycloak.env

[Service]
User=keycloak
Group=keycloak
EnvironmentFile=/etc/suveryn/keycloak.env
# Java 21, which this Keycloak release is checked on, also where an Ubuntu has newer Java (#57).
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# The network mode: the login page shows its "Air-gapped" badge only when it is true (keycloak/theme).
EnvironmentFile=-/etc/suveryn/network-mode.env
ExecStart=/opt/keycloak/bin/kc.sh start --optimized
Restart=on-failure
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
