# The appliance's own resolver (network-mode/README.md): every lookup goes to the office's DNS servers
# (/run/systemd/resolve/resolv.conf), and the addresses of approved destinations go into the outgoing
# rules' sets as they are answered. Starts as root to bind 127.0.0.1:53, then runs as suveryn-dns,
# keeping only the capability it needs to add to those sets.
[Unit]
Description=sūveryn resolver (approved destinations)
After=network.target systemd-resolved.service suveryn-egress.service
Requires=suveryn-egress.service
Before=nss-lookup.target
Wants=nss-lookup.target

# Once a network mode is set (first boot); on the read-only system enabled in the image (#47).
ConditionPathExists=/etc/suveryn/network-mode.env

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/suveryn/dnsmasq.conf
# Every program on the read-only system resolves through it while it runs: /etc/resolv.conf links to
# /run/suveryn/resolv.conf, which points here, and back to systemd-resolved's stub when it stops.
ExecStartPost=/bin/sh -c 'rm -f /run/suveryn/resolv.conf && printf "nameserver 127.0.0.1\\noptions edns0 trust-ad\\n" > /run/suveryn/resolv.conf'
ExecStopPost=/bin/sh -c 'rm -f /run/suveryn/resolv.conf && ln -s /run/systemd/resolve/stub-resolv.conf /run/suveryn/resolv.conf'
Restart=on-failure
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run/suveryn
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
