SHARE_SECRET = Path(ENV("SUVERYN_BACKUP_SHARE_SECRET", "/etc/suveryn/backups-share.secret"))
VAR = Path(ENV("SUVERYN_BACKUP_VAR", "/var/lib/suveryn"))
STATE = Path(ENV("SUVERYN_BACKUP_STATE", str(VAR / "backup")))
MOUNT = Path(ENV("SUVERYN_BACKUP_MOUNT", "/run/suveryn/backup-target"))
# The administrator's key test: the gateway leaves the recovery key and a request here (in memory, the
# gateway's folder), the path unit starts ``key-test``, which deletes the key whatever happens.
KEY_TEST = Path(ENV("SUVERYN_BACKUP_KEY_TEST", "/run/suveryn/backup-key-test"))
