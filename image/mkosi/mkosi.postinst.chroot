#!/bin/bash
# Inside the image, after the packages: what makes a read-only system work.
set -euo pipefail

# 1. The listed /etc paths that belong to the office link into the data partition. Nothing else in
#    /etc changes on the appliance (image/tests check this list against the design note).
link() { rm -rf "$2"; mkdir -p "$(dirname "$2")"; ln -s "$1" "$2"; }
link /var/lib/suveryn/etc              /etc/suveryn
link /var/lib/suveryn/host/hostname    /etc/hostname
link /var/lib/suveryn/host/hosts       /etc/hosts
link /var/lib/suveryn/host/localtime   /etc/localtime
link /var/lib/suveryn/host/keyboard    /etc/default/keyboard
link /var/lib/suveryn/network          /etc/systemd/network
link /var/lib/suveryn/nginx/suveryn    /etc/nginx/sites-enabled/suveryn
# The resolver: systemd-resolved's stub, or the appliance's own once a network mode is set (suveryn-dns, #38, #47).
link /run/suveryn/resolv.conf          /etc/resolv.conf

# The machine-id is mounted over this empty file from /var in the initrd (suveryn-boot-mode).
rm -f /etc/machine-id && : > /etc/machine-id
mkdir -p /usr/lib/suveryn && : > /usr/lib/suveryn/empty-machine-id

app=/opt/suveryn/appliance
# The sūveryn services (tracker #47; mkosi.conf.d/30-services.conf, the appliance only). Their users
# and the reader's sudo rule are made here; their folders on the data partition by tmpfiles.
if [ -e /usr/lib/sysusers.d/suveryn.conf ]; then
  systemd-sysusers /usr/lib/sysusers.d/suveryn.conf
  chmod 0440 /etc/sudoers.d/suveryn-reader
  visudo -cqf /etc/sudoers.d/suveryn-reader
  # PostgreSQL's cluster is made at first boot on the data partition (suveryn-provision first-boot),
  # with its configuration there too: drop the one the package made in the image.
  if pg_lsclusters -h 2>/dev/null | grep -q '^18 main '; then pg_dropcluster 18 main; fi
  rm -rf /var/lib/postgresql/18
  # sūveryn itself, from prebuilt/ (prebuild-services on a Pod): the build stops unless each part is the
  # pinned one. Read-only for every service: owned by root.
  python3 -I /opt/suveryn/appliance/provision/suveryn-provision check-prebuilt
  chown -R root:root /opt/suveryn/core /opt/suveryn/python /opt/suveryn/hf /opt/suveryn/llama.cpp /opt/suveryn/lib \
    /opt/suveryn/ui /opt/keycloak
  chmod -R a+rX /opt/suveryn /opt/keycloak
  # Keycloak writes only its data folder: on the data partition.
  rm -rf /opt/keycloak/data && ln -s /var/lib/suveryn/keycloak /opt/keycloak/data
  # llama-server finds the CUDA libraries it was built with (the driver itself is Ubuntu's).
  echo /opt/suveryn/lib/cuda > /etc/ld.so.conf.d/suveryn-cuda.conf && ldconfig
  # The reader sandbox and the network mode's tool, where provisioning puts them on an ordinary Ubuntu.
  install -d /opt/suveryn/bin /opt/suveryn/network-mode
  install -m 0755 "$app"/reader-sandbox/suveryn-reader-sandbox /opt/suveryn/bin/suveryn-reader-sandbox
  install -m 0644 "$app"/reader-sandbox/tests/probe.py /opt/suveryn/bin/suveryn-sandbox-probe.py
  install -m 0755 "$app"/network-mode/suveryn-network-mode /opt/suveryn/network-mode/suveryn-network-mode
  install -m 0644 "$app"/network-mode/builtin-destinations /opt/suveryn/network-mode/builtin-destinations
  ln -sf /opt/suveryn/network-mode/suveryn-network-mode /opt/suveryn/bin/suveryn-network-mode
  # Enabled now (/etc can't change later); each starts once first boot has written its settings.
  systemctl enable suveryn-llm.service keycloak.service suveryn-gateway.service
  # The network mode's outgoing rules and resolver, once first boot has set the mode.
  systemctl enable suveryn-egress.service suveryn-dns.service
  # Backups (#33): nightly, once the web setup has saved where to, and the administrator's key test and requests
  # from Administration › Backups. NFS needs no rpcbind for v4: none runs.
  systemctl enable suveryn-backup.timer suveryn-backup-key-test.path suveryn-backup-request.path
  systemctl mask rpcbind.service rpcbind.socket 2>/dev/null || true
fi
link /var/lib/suveryn/postgresql-etc   /etc/postgresql

# 2. The image's own /var is hidden by the data partition. Keep a copy and restore what is missing
#    on a fresh data partition (systemd-tmpfiles "C": copy only if absent).
rm -rf /usr/share/factory/var
mkdir -p /usr/share/factory
cp -a /var /usr/share/factory/var
rm -rf /usr/share/factory/var/{cache,log,tmp}/* /usr/share/factory/var/lib/apt/lists/*
{
  echo "# Generated by mkosi.postinst.chroot: the image's /var, restored where absent."
  for d in /usr/share/factory/var/lib/* /usr/share/factory/var/spool /usr/share/factory/var/opt; do
    [ -e "$d" ] && echo "C ${d#/usr/share/factory} - - - -"
  done
} > /usr/lib/tmpfiles.d/00-suveryn-factory-var.conf

# 3. Services: the network by DHCP, the resolver and time. Nothing is ever installed later (no apt).
systemctl enable systemd-networkd.service systemd-resolved.service systemd-timesyncd.service
# Inbound: the web ports only, before the network is up (/usr/lib/suveryn/inbound.nft).
systemctl enable suveryn-inbound.service
systemctl mask apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
# The appliance's identity, made at first boot on the data partition (#35).
systemctl enable suveryn-identity.service
# The console installer, on the stick only (#37); the console's font and keyboard layout at every start.
systemctl enable suveryn-installer.service suveryn-console.service
systemctl enable console-setup.service keyboard-setup.service 2>/dev/null || true  # enabled by their packages already

# The web setup (#37) and the office's site, from /opt/suveryn/appliance (mkosi.conf.d/20-web-setup.conf).
# Its user is made here: /etc/passwd can't be written on the appliance.
app=/opt/suveryn/appliance
find "$app" -name __pycache__ -prune -exec rm -rf {} +
# Of the theme only its pin (check-prebuilt reads it); and the skeleton's man folder (mkosi.skeleton).
[ -d "$app"/keycloak/theme ] && find "$app"/keycloak/theme -mindepth 1 -maxdepth 1 ! -name brand-lock.json -exec rm -rf {} +
rm -rf /usr/share/man
printf 'u suveryn-setup - "sūveryn web setup" /nonexistent /usr/sbin/nologin\n' > /usr/lib/sysusers.d/suveryn-setup.conf
systemd-sysusers /usr/lib/sysusers.d/suveryn-setup.conf
cp "$app"/setup/systemd/suveryn-setup.service "$app"/setup/systemd/suveryn-setup-provision.service \
   "$app"/setup/systemd/suveryn-setup-provision.path /usr/lib/systemd/system/
systemctl enable suveryn-setup.service suveryn-setup-provision.path
# nginx: the header snippets built in, no default site, and the office's site on the data partition
# (the link above). It starts once that site exists: the web setup writes it first.
install -m 0644 "$app"/reverse-proxy/suveryn-headers.conf "$app"/reverse-proxy/suveryn-csp.conf /etc/nginx/snippets/
rm -f /etc/nginx/sites-enabled/default
mkdir -p /usr/lib/systemd/system/nginx.service.d
printf '[Unit]\nConditionPathExists=/etc/nginx/sites-enabled/suveryn\n' > /usr/lib/systemd/system/nginx.service.d/suveryn.conf
systemctl enable nginx.service
printf 'd /var/lib/suveryn/nginx 0755 root root -\nd /var/log/nginx 0755 www-data adm -\n' > /usr/lib/tmpfiles.d/suveryn-nginx.conf

# 4. Third-party licences the packages would otherwise carry in /usr/share/doc, which WithDocs=no
#    leaves out. NVIDIA's driver licence (§1.1(d)) lets the image ship the driver only if the licence
#    text reaches every recipient, so a build that has the driver without the text stops here
#    (development context §2, tracker #49).
if dpkg-query -W 'nvidia-utils-*' 'libnvidia-compute-*' >/dev/null 2>&1; then
  test -s /usr/share/suveryn/licences/nvidia-graphics-drivers-580.copyright || {
    echo "the NVIDIA driver is installed but its licence text is not: see mkosi.extra/usr/share/suveryn/licences" >&2
    exit 1
  }
fi

# 5. No pcrlock: the data partition is bound to PCR 7 (#34); pcrlock policies (and the TPM NV index
#    they write) are decision D2, postponed. systemd 255 would generate one at every boot.
for u in /usr/lib/systemd/system/systemd-pcrlock*.service; do
  [ -e "$u" ] && systemctl mask "$(basename "$u")"
done
