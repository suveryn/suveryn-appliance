#!/usr/bin/python3
"""Make an installer stick of the test system, install from it and boot the result, in a virtual machine with a TPM.

The design's rules for the read-only system (#39), the encrypted data partition (#34), the appliance's
identity and system state (#35), signed bundles (#36) and installer mode (#37), checked by the self-test
inside the test system (mkosi.profiles/test/extra/usr/lib/suveryn-test/selftest):

1. install:        a stick made with make-stick (the test image, and a bundles partition with three test
                   bundles: a signed one, a changed one, one signed with an unknown key), an empty second
                   disk and a virtual TPM. The stick starts in installer mode (/var in memory, nothing
                   opened); the installer refuses a bad name and the changed bundle without writing
                   anything, then installs: slot A copied, data partition encrypted, the name, time zone,
                   network and the signed model written onto it, TPM and recovery key enrolled, a boot entry
2. first boot:     the installed disk; the TPM unlocks the data partition (no prompt); the installer's
                   settings and model are there; the identity is made, sealed to the TPM, and signs;
                   every rule passes
3. second boot:    the same, with the stick attached too: the appliance opens only its own disk's data
                   partition; the same machine-id, identity and model; the web setup open, unprivileged
4. web setup:      the setup screens driven in Chromium through a forwarded port, from Welcome to Complete,
                   against the appliance's setup service under systemd, with stand-ins for provisioning
                   (no sūveryn services or GPU in the test system); then setup closed for good
4. stick beside:   the stick started on the machine with the installed disk: installer mode, and the
                   appliance's data partition is never opened (no prompt either)
5. TPM replaced:   a new, empty TPM; the console asks for the recovery key; a wrong one is refused,
                   the right one opens the data partition and every rule passes; the identity is
                   kept but can't sign (it was sealed to the old TPM)
6. five wrong keys: a new TPM again; after five wrong keys the unlock gives up and nothing starts
7. a changed block in slot A: verity refuses it

Needs root, qemu-system-x86_64, OVMF, swtpm, sfdisk, losetup, mkfs.vfat and mtools, and for step 4
Python Playwright with Chromium and the test image built with the chat UI (test/make-test-ui). Without
KVM each boot takes two to five minutes.

    sudo image/mkosi/test/run-vm-tests [path/to/suveryn-test_<version>.raw]
"""

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
MKOSI = HERE.parent
RELEASE = MKOSI.parent.parent / "bundles" / "suveryn-bundle-release"
OVMF_CODE = Path("/usr/share/OVMF/OVMF_CODE_4M.fd")
OVMF_VARS = Path("/usr/share/OVMF/OVMF_VARS_4M.fd")
BOOT_TIMEOUT = int(os.environ.get("SUVERYN_VM_BOOT_TIMEOUT", "1200"))
ACCEL = "kvm" if os.access("/dev/kvm", os.W_OK) else "tcg"
PROMPT = re.compile(rb"Attempt [1-5]\S* of 5")  # the unlock screen (C8b)
GAVE_UP = re.compile(rb"couldn't be unlocked")
ANSWER_WINDOW = 20  # seconds a typed key may take to be checked (software emulation)
# The initrd may draw the same prompt again within seconds, as its other jobs finish; what was typed
# before that redraw is lost. So a key is typed only once the prompt has stood this long unchanged.
SETTLE = 6
WRONG_KEY = "cccccccc-cccccccc-cccccccc-cccccccc-cccccccc-cccccccc-cccccccc-cccccccc"

failed = 0


def note(text: str) -> None:
    print(f"== {text}", flush=True)


def ok(text: str) -> None:
    print(f"   ok   {text}", flush=True)


def bad(text: str) -> None:
    global failed
    failed += 1
    print(f"   FAIL {text}", flush=True)


class TPM:
    """A virtual TPM 2.0 (swtpm) whose state survives restarts of the machine, like a real one."""

    def __init__(self, state: Path):
        self.state = state
        state.mkdir(parents=True, exist_ok=True)

    def start(self) -> Path:
        sock = self.state / "swtpm.sock"
        sock.unlink(missing_ok=True)
        self.proc = subprocess.Popen(["swtpm", "socket", "--tpm2", "--tpmstate", f"dir={self.state}",
                                      "--ctrl", f"type=unixio,path={sock}", "--terminate"],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(50):
            if sock.exists():
                return sock
            time.sleep(0.1)
        raise RuntimeError("swtpm didn't start")

    def stop(self) -> None:
        if self.proc.poll() is None:
            self.proc.terminate()
            self.proc.wait()


class Console:
    """The serial console as a screen (pyte, a terminal emulator), for driving the console installer
    the way a person would: wait for text, press keys. Its script runs in a thread beside boot()."""

    def __init__(self, conn, cols=100, rows=30):
        import pyte
        self.conn, self.lock = conn, threading.Lock()
        self.screen = pyte.Screen(cols, rows)
        self.stream = pyte.ByteStream(self.screen)
        self.result, self.error, self.done = None, None, False
        self.fed = time.time()

    def feed(self, data: bytes):
        with self.lock:
            self.stream.feed(data)
            self.fed = time.time()

    @property
    def text(self) -> str:
        with self.lock:
            return "\n".join(line.rstrip() for line in self.screen.display)

    def wait(self, what: str, timeout=120):
        end, redraw = time.time() + timeout, time.time() + 20
        while time.time() < end:
            if what in self.text:
                quiet = time.time() + 10  # the rest of the screen still drawing (slow under TCG)
                while time.time() - self.fed < 1.5 and time.time() < quiet:
                    time.sleep(0.2)
                return self.text
            if time.time() > redraw:  # a stray console message may have overwritten the screen
                self.conn.sendall(b"\x0c")
                redraw = time.time() + 20
            time.sleep(0.5)
        raise AssertionError(f"{what!r} didn't appear; the console shows:\n{self.text}")

    def press(self, *keys, settle=1.0):
        for k in keys:
            self.conn.sendall(k.encode())
            time.sleep(0.3)
        time.sleep(settle)

    def run(self, script):
        try:
            self.result = script(self)
        except Exception as e:  # noqa: BLE001 (reported by the step)
            self.error = e
        self.done = True


def boot(work: Path, name: str, disks: list[Path], tpm: TPM, vars_file: Path, credential: str | None = None,
         keys: list[str] = (), quiet_after_keys: int = 0, stop_when_given_up: bool = False,
         ui=None, forward: str | None = None, beside=None) -> tuple[str, int]:
    """Boot until the machine powers off (or the timeout). Answers recovery-key prompts with `keys`, in
    order. With quiet_after_keys, stops once all keys are used and no new prompt came for that many
    seconds. With ui, a script that drives the console (Console); its result is in boot.ui. With forward
    (host address), the appliance's port 443 is reachable there; with beside, a function run in a thread
    meanwhile (its result or error in boot.beside).
    Returns (console output, number of prompts seen)."""
    log = work / f"{name}.log"
    sersock = work / f"{name}.serial"
    tpmsock = tpm.start()
    cmd = ["qemu-system-x86_64", "-machine", "q35", "-accel", ACCEL, "-cpu", "max", "-smp", "2", "-m", "2048",
           "-drive", f"if=pflash,format=raw,readonly=on,file={OVMF_CODE}",
           "-drive", f"if=pflash,format=raw,file={vars_file}",
           "-chardev", f"socket,id=chrtpm,path={tpmsock}", "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
           "-device", "tpm-crb,tpmdev=tpm0",
           "-nic", "user,model=virtio-net-pci" + (f",hostfwd=tcp:{forward}:443-:443" if forward else ""),
           "-display", "none", "-no-reboot",
           "-chardev", f"socket,id=ser0,path={sersock},server=on,wait=on", "-serial", "chardev:ser0"]
    for i, d in enumerate(disks):  # the firmware tries them in this order
        cmd += ["-drive", f"file={d},format=raw,if=none,id=disk{i}", "-device", f"virtio-blk-pci,drive=disk{i},bootindex={i}"]
    if credential:
        cmd += ["-smbios", f"type=11,value=io.systemd.credential:{credential}"]
    qemu = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=open(work / f"{name}.qemu", "w"))
    for _ in range(100):
        if sersock.exists():
            break
        time.sleep(0.1)
    conn = socket.socket(socket.AF_UNIX)
    conn.connect(str(sersock))
    buf = bytearray()
    prompts = 0
    pending = list(keys)
    last_prompt = time.time()
    ignore_until = 0.0   # after a key is typed, the prompt is redrawn while it's checked: not a new prompt
    drawn_at = None      # when the prompt waiting for an answer was last drawn
    scanned = 0          # how far buf has been searched for a prompt
    failed_after = None  # how many prompts came before the unlock service first gave up
    start = time.time()
    conn.settimeout(1)
    console = None
    if ui:
        console = Console(conn)
        threading.Thread(target=console.run, args=(ui,), daemon=True).start()
    boot.ui = console
    boot.beside = {}
    boot.ready = threading.Event()  # the self-test said "web-setup ready" (step 4b)
    if beside:
        def run_beside():
            try:
                boot.beside["result"] = beside()
            except Exception as e:  # noqa: BLE001 (reported by the step)
                boot.beside["error"] = e
        threading.Thread(target=run_beside, daemon=True).start()
    with open(log, "wb") as out:
        while qemu.poll() is None and time.time() - start < BOOT_TIMEOUT:
            try:
                chunk = conn.recv(65536)
            except socket.timeout:
                chunk = b""
            except OSError:
                break
            if chunk:
                out.write(chunk)
                out.flush()
                buf += chunk
                if b"SUVERYN-SELFTEST web-setup ready" in bytes(buf[-4096:]):
                    boot.ready.set()
                if console:
                    console.feed(chunk)
            if console and console.error:
                break
            if boot.beside.get("error"):  # the browser half failed: no need to wait for the timeout
                break
            tail = bytes(buf[-4096:])
            if failed_after is None and GAVE_UP.search(tail):
                failed_after = prompts
            # Search everything new (a burst of kernel messages can push a prompt out of the tail).
            for m in PROMPT.finditer(bytes(buf), scanned):
                drawn_at = time.time()
                scanned = m.end()
            if drawn_at and time.time() >= ignore_until and time.time() - drawn_at >= SETTLE:
                drawn_at = None
                scanned = 0
                prompts += 1
                last_prompt = time.time()
                del buf[:]  # each prompt answered once
                if pending:
                    time.sleep(1)
                    conn.sendall(pending.pop(0).encode() + b"\r")
                    ignore_until = time.time() + ANSWER_WINDOW
            if quiet_after_keys and not pending and prompts and time.time() - last_prompt > quiet_after_keys:
                break
            if stop_when_given_up and failed_after is not None:
                time.sleep(5)
                break
    conn.close()
    if qemu.poll() is None:
        qemu.terminate()
        qemu.wait()
    tpm.stop()
    boot.failed_after = failed_after
    return log.read_bytes().decode(errors="replace").replace("\r", ""), prompts


def selftest(output: str) -> dict:
    lines = [ln.split("SUVERYN-SELFTEST ", 1)[1].strip() for ln in output.splitlines() if "SUVERYN-SELFTEST " in ln]
    for ln in lines:
        print(f"   {ln}" if not ln.startswith("recovery-key") else "   recovery-key (hidden)", flush=True)
    value = lambda prefix: next((ln[len(prefix):].strip() for ln in lines if ln.startswith(prefix)), None)  # noqa: E731
    machine_id = next((ln.split(": ", 1)[1] for ln in lines if ln.startswith("ok   machine-id kept on /var")), None)
    return {"result": value("RESULT "), "recovery_key": value("recovery-key "), "machine_id": machine_id,
            "unlocked_by": value("unlocked-by "), "identity": value("identity ") or None}


def make_stick(work: Path, image: Path) -> Path:
    """The installer stick (make-stick, vfat for the test) with three test bundles (#36), signed with the
    test keys (test/make-test-keys): good (plus a file its manifest doesn't list), changed (one byte of
    good's weights flipped after signing) and untrusted (signed with a key the test system doesn't know)."""
    src = work / "bundles"
    good = src / "good"
    good.mkdir(parents=True)
    (good / "weights.bin").write_bytes(os.urandom(8 * 2**20))
    (good / "config.json").write_text('{"test": true}\n')
    rel = lambda *a: subprocess.run([sys.executable, str(RELEASE), *map(str, a)], check=True, capture_output=True)  # noqa: E731
    rel("make", good, "--kind", "model", "--name", "test-model", "--version", "1.0", "--title", "Test Model 1B",
        "--description", "A tiny model for the tests.", "--description-nl", "Een klein model voor de tests.",
        "--default")
    rel("sign", good, "--key-file", HERE / "keys" / "test-current.key")
    (good / "notes.txt").write_text("not in the manifest: never copied\n")
    shutil.copytree(good, src / "changed")
    with open(src / "changed" / "weights.bin", "r+b") as f:
        f.seek(4 * 2**20)
        b = f.read(1)
        f.seek(4 * 2**20)
        f.write(bytes([b[0] ^ 1]))
    shutil.copytree(good, src / "untrusted")
    rel("test-key", work / "untrusted.key")
    rel("sign", src / "untrusted", "--key-file", work / "untrusted.key")
    stick = work / "stick.raw"
    subprocess.run([sys.executable, str(MKOSI / "make-stick"), str(image), str(stick), "--size", "2G", "--fs", "vfat",
                    "--bundles", str(good), str(src / "changed"), str(src / "untrusted")], check=True, capture_output=True)
    return stick


def console_install(c: "Console") -> str:
    """Steps C1 to C7 on the serial console, with the answers a person would give, in Dutch. Returns the
    recovery key."""
    c.wait("Language, keyboard and time zone", timeout=900)
    assert "(*) English" in c.text and "Belgian (AZERTY)" in c.text and "Europe/Brussels" in c.text
    c.press("\x1b[B")  # Nederlands: the screens switch at once
    s = c.wait("Taal, toetsenbord en tijdzone")
    assert "Belgisch (AZERTY)" in s, s
    c.press("\t", "\t", "\t", "\t", "\r")
    s = c.wait("Hardware en doelschijf")
    assert "(*) vdb" in s and "√ Beveiliging" in s and "installatiemedium" in s, s
    c.press("\r")
    s = c.wait("Gevonden op dit installatiemedium", timeout=300)
    assert "[x]  Test Model 1B" in s and "Een klein model voor de tests." in s, s
    assert "Gewijzigd of beschadigd sinds de ondertekening." in s and "Handtekening ongeldig." in s, s
    c.press("\r")
    c.wait("Netwerkpoort")
    c.press("\t")
    for ch in "test-appliance":
        c.press(ch, settle=0)
    s = c.wait("Ontvangen: ", timeout=90)
    c.press("\r")
    s = c.wait("Klaar om te installeren")
    assert "test-appliance" in s and "Test Model 1B" in s and "Alle gegevens op vdb worden definitief gewist" in s, s
    for ch in "WISSEN":
        c.press(ch, settle=0)
    c.press("\r")
    s = c.wait("Schrijf de herstelsleutel van de schijf op", timeout=900)
    # The key's two lines, each inside its accent frame and the window's border (K6: two │ after it)
    m = re.search(r"([cbdefghijklnrtuv]{8}(?:-[cbdefghijklnrtuv]{8}){3})[\s│]*\n.*?([cbdefghijklnrtuv]{8}(?:-[cbdefghijklnrtuv]{8}){3})", s, re.S)
    assert m, s
    key = f"{m.group(1)}-{m.group(2)}"
    for ch in key.split("-")[0]:
        c.press(ch, settle=0)
    c.wait("√ klopt")
    c.press("\r")
    return key


def console_after_boot(c: "Console") -> bool:
    """C8 on the serial console of the installed appliance (installed in Dutch): read it, open the network
    details and the registration QR code, change the network to a fixed address, shut down."""
    s = c.wait("Kies een optie", timeout=900)
    flat = lambda: " ".join(c.text.replace("│", " ").split())  # noqa: E731
    s = flat()
    assert "https://test-appliance.local" in s and "versleuteld · ontgrendeld door de TPM" in s, s
    assert re.search(r"Appliance-ID [0-9a-f-]{36}", s) and "geen geldig manifest" in s, s
    c.press("1")
    c.wait("Netwerkgegevens")
    assert "test-appliance.local" in c.text and "10.0.2.15/24" in c.text, c.text
    c.press(" ")
    c.wait("Kies een optie")
    c.press("3")
    s = c.wait("Registratie")
    assert "▀" in s and "▄" in s and "Scan deze code" in s, s  # qrencode's half blocks
    c.press(" ")
    c.wait("Kies een optie")
    c.press("2")
    c.wait("Netwerkinstellingen wijzigen")
    time.sleep(5)  # the screen takes keys once it has read the ports (slow under TCG, with the web setup starting too)
    c.press("\t", "\t", "\x1b[B", "\t")  # name, address: fixed, IP address
    for text in ("10.0.2.15/24", "\t", "10.0.2.2", "\t", "10.0.2.3"):
        for ch in text:
            c.press(ch, settle=0)
    c.press("\r", settle=5)
    # The new address on the status screen (not just "Kies een optie": that line can still be on the
    # serial screen from before, under the network screen, while the console is slow).
    s = c.wait("· vast", timeout=180)
    assert "10.0.2.15/24 · vast" in " ".join(s.replace("│", " ").split()), s
    c.press("5")
    c.wait("De appliance uitschakelen?")
    c.press("\r")
    return True


def web_setup_test(work: Path, identity: str):
    """Step 4's browser half: the manifests for this appliance (signed with the portal's test key) and
    another, a share server on the host (10.0.2.2 to the appliance), then the screens (setup/tests)."""
    import importlib.machinery
    import importlib.util
    repo = MKOSI.parent.parent
    loader = importlib.machinery.SourceFileLoader("browser_check", str(repo / "setup" / "tests" / "browser_check.py"))
    spec = importlib.util.spec_from_loader("browser_check", loader)
    bc = importlib.util.module_from_spec(spec)
    loader.exec_module(bc)
    uuid = identity.split()[0]
    tool, key = repo / "support" / "suveryn-manifest", HERE / "keys" / "test-portal.key"
    for name, appliance in (("manifest.yaml", uuid), ("other.yaml", "00000000" + uuid[8:])):
        subprocess.run([sys.executable, tool, "make", work / name, "--appliance", appliance, "--edition", "Sūveryn Enterprise",
                        "--users", "15", "--valid-until", "2099-09-30", "--next-check-in", "2099-12-31"], check=True,
                       capture_output=True)
        subprocess.run([sys.executable, tool, "sign", work / name, "--key-file", key], check=True, capture_output=True)
    listener = socket.socket()  # QEMU's user network takes the appliance's 10.0.2.2:445 to the host's 445
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("127.0.0.1", 445))
    listener.listen()
    threading.Thread(target=lambda: [listener.accept()[0].close() for _ in iter(int, 1)], daemon=True).start()
    m = {"host": "test-appliance.local", "connect": WEB, "address": "10.0.2.15", "share": "10.0.2.2", "appliance": uuid,
         "manifest": work / "manifest.yaml", "other": work / "other.yaml", "out": work, "answers": None, "slow": 10,
         "language": "nl"}  # installed in Dutch (step 2)
    # Until the self-test inside has checked setup is open (then the screens may close it), and the
    # setup service answers here too.
    if not boot.ready.wait(BOOT_TIMEOUT):
        raise AssertionError("the self-test never said the web setup was ready")
    for _ in range(BOOT_TIMEOUT // 5):
        try:
            if bc.direct().open(bc.urllib.request.Request(f"https://{WEB}/setup/v1/state", headers={"Host": m["host"]}),
                                timeout=10).status == 200:
                break
        except OSError:
            pass
        time.sleep(5)
    bc.browse(m)
    listener.close()
    return bc.results


WEB = "127.0.0.2"  # where the host reaches the appliance's port 443 in step 4


def main() -> int:
    image = Path(sys.argv[1]) if len(sys.argv) > 1 else max(MKOSI.glob("mkosi.output/suveryn-test_*.raw"),
                                                            key=os.path.getmtime, default=None)
    if not image or not image.exists():
        print("no test image: cd image/mkosi && test/make-test-keys && mkosi -f --profile test build", file=sys.stderr)
        return 2
    if not (HERE / "keys" / "test-current.key").exists():
        print("no test keys: image/mkosi/test/make-test-keys, then build the test image again", file=sys.stderr)
        return 2
    work = Path(os.environ.get("SUVERYN_VM_WORK") or tempfile.mkdtemp(prefix="suveryn-vm-", dir="/var/tmp"))
    work.mkdir(parents=True, exist_ok=True)
    note(f"image {image}, work folder {work}, acceleration: {ACCEL}")

    stick, target = make_stick(work, image), work / "target.raw"
    with open(target, "wb") as f:
        f.truncate(6 * 2**30)
    tpm = TPM(work / "tpm")
    shutil.copyfile(OVMF_VARS, work / "vars-install.fd")
    shutil.copyfile(OVMF_VARS, work / "vars.fd")

    note("1. the installer's checks, on an empty disk")
    scratch = work / "scratch.raw"
    with open(scratch, "wb") as f:
        f.truncate(6 * 2**30)
    out, prompts = boot(work, "checks", [stick, scratch], tpm, work / "vars.fd", credential="suveryn.test=install-checks")
    r = selftest(out)
    if r["result"] == "PASS" and prompts == 0:
        ok("installer mode without a prompt; the stick's bundles checked; a bad name and a changed bundle refused, "
           "nothing written")
    else:
        bad(f"result {r['result']}, {prompts} prompt(s) (console: {work}/checks.log)")
    scratch.unlink()

    note("2. install with the console installer, as a person would")
    out, prompts = boot(work, "install", [stick, target], tpm, work / "vars-install.fd",
                        credential="suveryn.installer-on-serial=1", ui=console_install)
    ui = boot.ui
    key = ui.result if ui and not ui.error else None
    if key and re.fullmatch(r"([cbdefghijklnrtuv]{8}-){7}[cbdefghijklnrtuv]{8}", key) and prompts == 0:
        ok("C1 to C7 on the console, in Dutch: the signed model offered and the other two skipped, installed, the "
           "recovery key shown and confirmed, restarted")
    else:
        bad(f"the console installer didn't finish: {ui.error if ui else 'no console'} (console: {work}/install.log)")
        print(f"\n{failed} FAILED (kept: {work})")
        return 1

    machine_ids, identities = [], []
    for n in (3, 4):
        note(f"{n}. boot {n - 2} of the installed disk: the TPM unlocks it"
             + ("; the stick attached too" if n == 4 else "; the installer's boot entry"))
        out, prompts = boot(work, f"boot{n - 2}", [target, stick] if n == 4 else [target], tpm,
                            work / ("vars.fd" if n == 4 else "vars-install.fd"),
                            credential=None if n == 4 else "suveryn.test=first-boot")
        r = selftest(out)
        machine_ids.append(r["machine_id"])
        identities.append(r["identity"])
        if r["result"] == "PASS" and prompts == 0:
            ok("every rule passed, unlocked by the TPM without a prompt")
        else:
            bad(f"result {r['result']}, {prompts} prompt(s) (console: {work}/boot{n - 2}.log)")
    if machine_ids[0] and machine_ids[0] == machine_ids[1]:
        ok(f"the machine-id survives a restart ({machine_ids[0]})")
    else:
        bad(f"the machine-id changed between boots ({machine_ids})")
    if identities[0] and identities[0] == identities[1]:
        ok(f"the identity survives a restart ({identities[0].split()[0]})")
    else:
        bad(f"the identity changed between boots, or is missing ({identities})")

    note("4b. the web setup in a browser, through to Complete")
    if not (HERE / "ui" / "setup.html").exists() or not (HERE / "keys" / "test-portal.key").exists():
        bad("no chat UI or portal key in the test image: test/make-test-ui and test/make-test-keys, then build again")
    else:
        out, prompts = boot(work, "web-setup", [target], tpm, work / "vars.fd", credential="suveryn.test=web-setup",
                            forward=WEB, beside=lambda: web_setup_test(work, identities[0] or ""))
        r = selftest(out)
        res = boot.beside.get("result") or []
        for name, passed in res:
            print(f"   {'ok  ' if passed else 'FAIL'} {name}", flush=True)
        if boot.beside.get("error") or not res or not all(p for _, p in res):
            bad(f"the screens didn't run through: {boot.beside.get('error')!r} (screenshots and console: {work})")
        elif r["result"] == "PASS" and prompts == 0:
            ok(f"the screens from Welcome to Complete ({len(res)} checks), the setup service under systemd, then closed")
        else:
            bad(f"result {r['result']}, {prompts} prompt(s) (console: {work}/web-setup.log)")

    note("5. the console of the installed appliance (C8), as a person would use it")
    out, prompts = boot(work, "console", [target], tpm, work / "vars.fd", credential="suveryn.console-on-serial=1",
                        ui=console_after_boot)
    ui = boot.ui
    if ui and ui.result and not ui.error and prompts == 0:
        ok("the addresses, disk, ID and support shown in Dutch; network details; the registration QR code; the "
           "network changed to a fixed address; shut down")
    else:
        bad(f"the console didn't work as expected: {ui.error if ui else 'no console'} (console: {work}/console.log)")

    note("6. the stick started on the machine with the installed disk")
    out, prompts = boot(work, "beside", [stick, target], tpm, work / "vars.fd", credential="suveryn.test=stick-beside")
    r = selftest(out)
    if r["result"] == "PASS" and prompts == 0:
        ok("installer mode; the installed disk's data partition wasn't opened, nothing asked")
    else:
        bad(f"result {r['result']}, {prompts} prompt(s) (console: {work}/beside.log)")

    note("7. TPM replaced: the unlock screen (C8b) and the recovery key")
    new_tpm = TPM(work / "tpm-new")
    out, prompts = boot(work, "recovery", [target], new_tpm, work / "vars.fd",
                        credential="suveryn.test=tpm-replaced", keys=[WRONG_KEY, key.replace("-", "").upper()])
    r = selftest(out)
    screen = "The disk can't unlock by itself." in out and "That key doesn't open this disk." in out
    if prompts == 2 and screen and r["result"] == "PASS" and r["machine_id"] == machine_ids[0] \
            and r["identity"] == identities[0]:
        ok("the unlock screen; a wrong key refused; the right one opened the disk (typed without dashes, in "
           "capitals); the TPM enrolled again; every rule passed; the identity kept, refusing to sign")
    else:
        bad(f"{prompts} prompt(s), unlock screen seen: {screen}, result {r['result']} (console: {work}/recovery.log)")

    note("8. the next start with the new TPM: unattended again")
    out, prompts = boot(work, "again", [target], new_tpm, work / "vars.fd", credential="suveryn.test=tpm-again")
    r = selftest(out)
    if prompts == 0 and r["result"] == "PASS":
        ok("unlocked by the TPM, no prompt")
    else:
        bad(f"{prompts} prompt(s), result {r['result']} (console: {work}/again.log)")

    note("9. wrong keys: after five the unlock gives up, and the data partition stays closed")
    out, prompts = boot(work, "tries", [target], TPM(work / "tpm-other"), work / "vars.fd",
                        keys=[WRONG_KEY] * 6, stop_when_given_up=True)
    if boot.failed_after == 5 and "RESULT" not in out:
        ok("five wrong keys refused, then the unlock screen said so and waited; nothing started")
    else:
        bad(f"the unlock gave up after {boot.failed_after} prompt(s) of {prompts}; "
            f"result seen: {'RESULT' in out} (console: {work}/tries.log)")

    note("10. a changed block in slot A")
    changed = work / "target-changed.raw"
    # Sparse, as the disk is: a plain copy writes out all 6 GiB (the cloud check ran out of space, #57).
    subprocess.run(["cp", "--sparse=always", target, changed], check=True)
    layout = subprocess.run(["sfdisk", "--json", str(changed)], capture_output=True, text=True, check=True).stdout
    part = json.loads(layout)["partitiontable"]["partitions"][1]
    offset = (part["start"] + part["size"] // 2) * 512 + 123
    with open(changed, "r+b") as f:
        f.seek(offset)
        byte = f.read(1)
        f.seek(offset)
        f.write(bytes([(byte[0] + 1) % 256]))
    out, _ = boot(work, "changed", [changed], new_tpm, work / "vars.fd")  # the disk's TPM since step 7
    corrupted = re.search(r"verity.*(data block .* is corrupted|corrupt)", out, re.I)
    if "RESULT PASS" in out:
        bad(f"the changed system passed: verity didn't notice (console: {work}/changed.log)")
    elif corrupted:
        ok(f"verity refused the changed block: {corrupted.group(0)[:100]}")
    else:
        bad(f"the changed system didn't pass, but no verity error was seen (console: {work}/changed.log)")

    print()
    if failed == 0:
        print("ALL PASSED")
        shutil.rmtree(work)
        return 0
    print(f"{failed} FAILED (kept: {work})")
    return 1


if __name__ == "__main__":
    sys.exit(main())
