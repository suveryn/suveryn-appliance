# ---------------------------------------------------------------------------- the program
class App:
    def __init__(self, scr, system):
        self.scr, self.system = scr, system
        self.answers = {"language": "en", "keyboard": "be", "timezone": "Europe/Brussels", "models": None}
        self.version = system.version()
        self.models, self.models_started = None, time.time()
        threading.Thread(target=self.check_models, daemon=True).start()
        self.ink = Ink()
        self.screens: dict = {}
        self.screen = None
        self.focus = 0
        self.help_open = False
        self.go(Language)

    def check_models(self):
        try:
            self.models = self.system.models()
        except Exception as e:  # noqa: BLE001 (shown, not hidden)
            self.models = [{"folder": "?", "valid": False, "error": str(e)}]

    def go(self, cls):
        # A screen keeps its fields when you come back to it; the ones after the hardware check are
        # rebuilt from the answers, which may have changed.
        if cls not in self.screens or cls in (Models, Summary, Installing, RecoveryKey):
            self.screens[cls] = cls(self)
        self.screen, self.focus, self.help_open = self.screens[cls], 0, False
        self.screen.error = ""

    def fields(self):
        return self.screen.fields()

    def draw(self):
        scr, ink = self.scr, self.ink
        scr.erase()
        rows, cols = scr.getmaxyx()
        def put(y, x, text, style="text"):
            if 0 <= y < rows and x < cols:
                try:
                    scr.addstr(y, max(0, x), text[: max(0, cols - x - (1 if y == rows - 1 else 0))], ink(style))
                except curses.error:
                    pass
        put(0, 0, " " * cols, "bar")
        put(0, 1, "Sūveryn", "strong")
        put(0, 9, "installer", "dim")
        right = f"{self.version} · Step {self.screen.step} of {STEPS} "
        put(0, cols - len(right), right, "dim")
        width = min(cols - 4, 92)
        c = Canvas(width - 6)
        fields = self.fields()
        focus = fields[self.focus] if fields and self.focus < len(fields) else None
        self.screen.body(c, focus)
        buttons = [f for f in fields if isinstance(f, Button)]
        if self.screen.error:
            c.blank()
            c.add((f"{WARN} ", "accent"), (self.screen.error, "accent"))
        lines = c.lines
        while len(lines) + (4 if buttons else 2) > rows - 2 and [] in lines:  # a small console: fewer gaps
            lines.remove([])
        height = len(lines) + (4 if buttons else 2)
        top = max(1, (rows - height) // 2)
        left = (cols - width) // 2
        try:
            win = scr.derwin(min(height, rows - 2), width, top, left)
            win.attrset(ink("dim"))
            win.border()
        except curses.error:
            win = None
        put(top, left + 2, f" {self.screen.title} ", "strong")
        for i, line in enumerate(lines):
            x = left + 3
            for text, style in line:
                put(top + 1 + i, x, text, style)
                x += len(text)
        if buttons:
            x = left + width - 3 - sum(len(b.label) + 3 for b in buttons)
            for b in buttons:
                put(top + height - 2, x, b.label, "focus" if b is focus else "text")
                x += len(b.label) + 3
        if self.help_open and self.screen.help:
            hc = Canvas(min(cols - 10, 70))
            for para in self.screen.help.split("\n"):
                hc.wrap(para)
            hc.blank()
            hc.add(("To leave the installer, remove the stick and press Ctrl+Alt+Del.", "dim"))
            hc.add(("Esc closes this help.", "dim"))
            hy = max(2, (rows - len(hc.lines) - 2) // 2)
            hx = (cols - hc.width - 4) // 2
            for i in range(len(hc.lines) + 2):
                put(hy + i, hx, " " * (hc.width + 4), "field")
            put(hy, hx + 2, " Help ", "strong")
            for i, line in enumerate(hc.lines):
                x = hx + 2
                for text, style in line:
                    put(hy + 1 + i, x, text, "field")
                    x += len(text)
        put(rows - 1, 0, " " * (cols - 1), "bar")
        x = 1
        for k, v in self.screen.footer:
            if k:
                put(rows - 1, x, k, "strong")
                x += len(k) + 1
            put(rows - 1, x, v, "dim")
            x += len(v) + 3
        scr.refresh()

    def handle(self, k):
        if self.help_open:
            if k in (27, curses.KEY_F1):
                self.help_open = False
            return
        if k == curses.KEY_F1:
            self.help_open = True
            return
        if k == 12:  # Ctrl+L
            self.scr.clear()
            return
        if isinstance(self.screen, Installing) and not self.screen.failed:
            return  # keys are disabled while installing
        fields = self.fields()
        if not fields:
            return
        self.focus = min(self.focus, len(fields) - 1)
        f = fields[self.focus]
        if isinstance(f, Select) and f.open:
            f.key(k)
            return
        if k == 9:  # Tab
            self.focus = (self.focus + 1) % len(fields)
            return
        if k == curses.KEY_BTAB:
            self.focus = (self.focus - 1) % len(fields)
            return
        if k == 27:
            self.act("back")
            return
        if isinstance(f, (Radio, Checklist)) or (isinstance(f, Select) and k in (10, 13, curses.KEY_ENTER, ord(" "))):
            if k in (10, 13, curses.KEY_ENTER) and not isinstance(f, Select):
                self.act("next")
                return
            f.key(k)
            self.screen.error = ""
            return
        if isinstance(f, Button):
            if k in (10, 13, curses.KEY_ENTER):
                self.act(f.action)
            elif k in (curses.KEY_UP, curses.KEY_LEFT):
                self.focus = (self.focus - 1) % len(fields)
            elif k in (curses.KEY_DOWN, curses.KEY_RIGHT):
                self.focus = (self.focus + 1) % len(fields)
            return
        if k in (10, 13, curses.KEY_ENTER):
            self.act("restart" if isinstance(self.screen, RecoveryKey) else "next")
            return
        if k == curses.KEY_UP:
            self.focus = (self.focus - 1) % len(fields)
            return
        if k == curses.KEY_DOWN:
            self.focus = (self.focus + 1) % len(fields)
            return
        f.key(k)
        self.screen.error = ""

    def act(self, action):
        s = self.screen
        if action == "back":
            if isinstance(s, Installing):
                self.go(Summary)
            elif not isinstance(s, (Language, RecoveryKey)):
                self.go(FLOW[FLOW.index(type(s)) - 1])
        elif action == "retry" and isinstance(s, Network):
            s.key("retry")
        elif action == "next":
            err = s.leave()
            if err:
                s.error = err
                return
            if isinstance(s, Summary):
                self.go(Installing)
            else:
                self.go(FLOW[FLOW.index(type(s)) + 1])
        elif action == "restart" and isinstance(s, RecoveryKey):
            err = s.leave()
            if err:
                s.error = err
                return
            s.error = ""
            self.draw()
            self.system.reboot()

    def run(self):
        curses.curs_set(0)
        self.scr.keypad(True)
        self.scr.timeout(500)
        while True:
            self.screen.tick()
            self.draw()
            try:
                k = self.scr.get_wch()
            except curses.error:
                continue
            # Plain ASCII as numbers (Tab 9, Enter 10, Esc 27, Space 32, Backspace 127); other letters
            # (ū, é) stay text.
            if isinstance(k, str) and len(k) == 1 and ord(k) < 128:
                k = ord(k)
            self.handle(k)


def main() -> int:
    os.environ.setdefault("ESCDELAY", "50")
    fake = os.environ.get("SUVERYN_INSTALLER_FAKE")
    system = FakeSystem(fake) if fake else RealSystem()
    if not fake and Path("/run/suveryn/boot-mode").read_text().strip() != "installer":
        print("installer-ui: this system didn't start from the installer stick", file=sys.stderr)
        return 2
    import locale
    locale.setlocale(locale.LC_ALL, "C.UTF-8")
    curses.wrapper(lambda scr: App(scr, system).run())
    return 0


if __name__ == "__main__":
    sys.exit(main())
