class Installing(Screen):
    title, step = "Installing the sūveryn appliance", 6
    footer = [("", "Installation in progress. Keys are disabled.")]

    def __init__(self, app):
        super().__init__(app)
        a = app.answers
        self.items = ["Checking the language models against their signatures",
                      f"Partitioning {a['disk']} and copying system files",
                      "Encrypting the disk (LUKS2, a new key for this machine)",
                      "Copying language models",
                      "Applying the name and network settings",
                      "Linking the disk key to this machine's TPM",
                      "Installing the boot loader"]
        self.at, self.detail, self.percent = 0, "", 0.0
        self.failed, self.result, self.lines = None, None, []
        self.done = False
        args = ["--disk", f"/dev/{a['disk']}", "--name", a["name"], "--language", a["language"],
                "--keyboard", a["keyboard"], "--timezone", a["timezone"], "--interface", a["interface"]]
        if a["address_mode"] == "fixed":
            args += ["--address", a["fixed_address"], "--dns", a["fixed_dns"]]
            if a["fixed_gateway"]:
                args += ["--gateway", a["fixed_gateway"]]
        for m in a["models"]:
            args += ["--model", m]
        self.proc = app.system.run_install(args)
        self.sizes = {m["folder"]: m["size"] for m in app.models or [] if m.get("valid")}
        self.total_models = sum(self.sizes.get(m, 0) for m in a["models"]) or 1
        self.copied, self.checked, self.current = 0, 0, None
        threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        for line in self.proc.stderr:
            line = line.rstrip()
            self.lines.append(line)
            self.follow(line)
        out = self.proc.stdout.read()
        code = self.proc.wait()
        if code == 0:
            try:
                self.result = json.loads(out)
                self.at, self.percent = len(self.items), 100.0
            except ValueError:
                self.failed = "the installer gave no result"
        else:
            last = [ln for ln in self.lines if not ln.startswith(("bundle:", "step ", "install-disk ["))]
            self.failed = (last[-1] if last else f"exit {code}").removeprefix("install: ")
        self.done = True

    def follow(self, line):
        a = self.app.answers
        m = re.match(r"install: checking (.+)", line)
        if m:
            self.at, self.current = 0, m.group(1)
            self.detail = f"{a['models'].index(self.current) + 1} of {len(a['models'])}" if self.current in a["models"] else ""
        elif line.startswith("step 1/"):
            self.at, self.detail, self.percent = 1, "", 25.0
        elif line.startswith("install-disk") and "enrolling" in line:
            pass
        elif line.startswith("step 2/"):
            self.at, self.percent = 3, 40.0
        elif (m := re.match(r"install: copying (.+)", line)):
            self.current = m.group(1)
            n = a["models"].index(self.current) + 1 if self.current in a["models"] else 0
            title = a["model_titles"][n - 1] if n else self.current
            self.detail = f"{n} of {len(a['models'])} · {title}"
        elif (m := re.match(r"bundle: \[(\d+)/(\d+)\] .* \((\d+) MiB\)", line)):
            if self.at == 3:
                self.copied += int(m.group(3)) * 2**20
                self.percent = 40.0 + 40.0 * min(1.0, self.copied / self.total_models)
            else:
                self.checked += int(m.group(3)) * 2**20
                self.percent = 20.0 * min(1.0, self.checked / self.total_models)
        elif line.startswith("step 3/"):
            self.at, self.detail, self.percent = 5, "", 85.0
        elif line.startswith("step 4/"):
            self.at, self.percent = 6, 95.0

    def tick(self):
        if self.done and self.result and not self.failed:
            self.app.answers["result"] = self.result
            self.app.go(RecoveryKey)
        return True

    def body(self, c, focus):
        w = min(46, c.width - 10)
        filled = int(w * self.percent / 100)
        c.add(("█" * filled, "accent"), ("░" * (w - filled), "dim"), (f"  {int(self.percent)}%", "text"))
        c.blank()
        for i, text in enumerate(self.items):
            if i < self.at or (self.done and not self.failed):
                c.add((f"{CHECK} ", "ok"), (text, "text"))
            elif i == self.at:
                c.add((f"{WARN if self.failed else ARROW} ", "accent"),
                      (text + (f" · {self.detail}" if self.detail and i in (0, 3) else ""), "accent"))
            else:
                c.add(("  ", "text"), (text, "dim"))
        c.blank()
        if self.failed:
            c.add((f"{WARN} ", "accent"), ("The installation failed.", "strong"))
            c.wrap(self.failed[:1].upper() + self.failed[1:], "accent", indent=2)
            c.wrap(f"Nothing on the stick changed. The disk {self.app.answers['disk']} may be partly written; "
                   "installing again erases it anew.", "dim", indent=2)
        else:
            c.add(("This takes about ten minutes. Do not turn off the machine.", "text"))
            c.add(("Then you write down the disk recovery key, and the machine restarts.", "dim"))
            c.add(("This appliance's ID and signing key are made at its first start.", "dim"))

    def fields(self):
        if self.failed:
            self.footer = [("Enter", "Back to the summary")]
            return [Button("< Back to the summary >", "back")]
        return []


