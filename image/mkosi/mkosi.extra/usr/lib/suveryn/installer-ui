class Installing(Screen):
    title_key, step = "c6_title", 6
    keys = [("", "c6_keys_off")]

    def __init__(self, app):
        super().__init__(app)
        a = app.answers
        self.items = [t("c6_check_models"), t("c6_partition", disk=a["disk"]), t("c6_encrypt"), t("c6_copy_models"),
                      t("c6_settings"), t("c6_tpm"), t("c6_boot")]
        self.at, self.detail, self.percent = 0, "", 0.0
        self.failed, self.result, self.lines = None, None, []
        self.done = False
        args = ["--disk", f"/dev/{a['disk']}", "--name", a["name"], "--language", a["language"],
                "--keyboard", a["keyboard"], "--timezone", a["timezone"], "--interface", a["interface"]]
        if a["address_mode"] == "fixed":
            args += ["--address", a["fixed_address"], "--dns", a["fixed_dns"]]
            if a["fixed_gateway"]:
                args += ["--gateway", a["fixed_gateway"]]
        for m in a["models"]:
            args += ["--model", m]
        self.proc = app.system.run_install(args)
        self.sizes = {m["folder"]: m["size"] for m in app.models or [] if m.get("valid")}
        self.total_models = sum(self.sizes.get(m, 0) for m in a["models"]) or 1
        self.copied, self.checked, self.current = 0, 0, None
        threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        for line in self.proc.stderr:
            line = line.rstrip()
            self.lines.append(line)
            self.follow(line)
        out = self.proc.stdout.read()
        code = self.proc.wait()
        if code == 0:
            try:
                self.result = json.loads(out)
                self.at, self.percent = len(self.items), 100.0
            except ValueError:
                self.failed = t("c6_no_result")
        else:
            last = [ln for ln in self.lines if not ln.startswith(("bundle:", "step ", "install-disk ["))]
            self.failed = (last[-1] if last else f"exit {code}").removeprefix("install: ")
        self.done = True

    def follow(self, line):
        a = self.app.answers
        m = re.match(r"install: checking (.+)", line)
        if m:
            self.at, self.current = 0, m.group(1)
            self.detail = t("c6_n_of", n=a["models"].index(self.current) + 1, total=len(a["models"])) \
                if self.current in a["models"] else ""
        elif line.startswith("step 1/"):
            self.at, self.detail, self.percent = 1, "", 25.0
        elif line.startswith("install-disk") and "enrolling" in line:
            pass
        elif line.startswith("step 2/"):
            self.at, self.percent = 3, 40.0
        elif (m := re.match(r"install: copying (.+)", line)):
            self.current = m.group(1)
            n = a["models"].index(self.current) + 1 if self.current in a["models"] else 0
            title = a["model_titles"][n - 1] if n else self.current
            self.detail = f"{t('c6_n_of', n=n, total=len(a['models']))} · {title}"
        elif (m := re.match(r"bundle: \[(\d+)/(\d+)\] .* \((\d+) MiB\)", line)):
            if self.at == 3:
                self.copied += int(m.group(3)) * 2**20
                self.percent = 40.0 + 40.0 * min(1.0, self.copied / self.total_models)
            else:
                self.checked += int(m.group(3)) * 2**20
                self.percent = 20.0 * min(1.0, self.checked / self.total_models)
        elif line.startswith("step 3/"):
            self.at, self.detail, self.percent = 5, "", 85.0
        elif line.startswith("step 4/"):
            self.at, self.percent = 6, 95.0

    def tick(self):
        if self.done and self.result and not self.failed:
            self.app.answers["result"] = self.result
            self.app.go(RecoveryKey)
        return True

    def body(self, c, focus):
        w = min(46, c.width - 10)
        filled = int(w * self.percent / 100)
        c.add(("█" * filled, "accent"), ("░" * (w - filled), "dim"), (f"  {int(self.percent)}%", "text"))
        c.blank()
        for i, text in enumerate(self.items):
            if i < self.at or (self.done and not self.failed):
                c.add((f"{CHECK} ", "ok"), (text, "text"))
            elif i == self.at:
                c.add((f"{WARN if self.failed else ARROW} ", "accent"),
                      (text + (f" · {self.detail}" if self.detail and i in (0, 3) else ""), "accent"))
            else:
                c.add(("  ", "text"), (text, "dim"))
        c.blank()
        if self.failed:
            c.add((f"{WARN} ", "accent"), (t("c6_failed"), "strong"))
            c.wrap(self.failed[:1].upper() + self.failed[1:], "accent", indent=2)
            c.wrap(t("c6_failed_note", disk=self.app.answers["disk"]), "dim", indent=2)
        else:
            c.wrap(t("c6_duration"), "text")
            c.wrap(t("c6_then"), "dim")
            c.wrap(t("c6_identity"), "dim")

    def fields(self):
        if self.failed:
            self.keys = [("Enter", "c6_back_summary")]
            return [Button(lambda: t("button_back_summary"), "back")]
        return []


class RecoveryKey(Screen):
    title_key, help_key, step = "c7_title", "c7_help", 6
    keys = [("Enter", "key_restart"), ("", "c7_remove_medium")]

    def __init__(self, app):
        super().__init__(app)
        self.key_text = app.answers["result"]["recovery_key"]
        self.confirm = Text(lambda: t("c7_confirm") + "  ", "", width=10, max_len=8)
        self.restart = Button(lambda: t("button_restart"), "restart")

    def fields(self):
        return [self.confirm, self.restart]

    @property
    def default(self):
        """Enter restarts from the field too (once the key matches): the button shows it."""
        return self.restart

    def body(self, c, focus):
        c.add((f"{CHECK} ", "ok"), (t("c7_encrypted"), "text"))
        c.wrap(t("c7_only_if"), "dim", indent=2)
        c.blank()
        groups = self.key_text.split("-")
        lines = ["-".join(groups[:4]), "-".join(groups[4:])]
        inner = max(len(x) for x in lines) + 4
        pad = " " * max(0, (c.width - inner - 2) // 2)
        c.lines.append([(pad, "text"), ("┌" + "─" * inner + "┐", "accent")])  # as drawn, never wrapped
        for x in lines:
            c.lines.append([(pad, "text"), ("│", "accent"), (x.center(inner), "strong"), ("│", "accent")])
        c.lines.append([(pad, "text"), ("└" + "─" * inner + "┘", "accent")])
        c.blank()
        c.add((f"{WARN} ", "accent"), (t("c7_once"), "strong"))
        c.wrap(t("c7_paper"), "dim", indent=2)
        c.blank()
        ok = self.confirm.value == groups[0]
        col = len(text_of(self.confirm.label))
        self.confirm.draw(c, focus is self.confirm, col)
        if ok:  # on the field's own line when it fits
            line = c.lines[-1]
            mark = f"  {CHECK} {t('c7_matches')}"
            if sum(len(x) for x, _ in line) + len(mark) <= c.width:
                line.append((mark, "ok"))
            else:
                c.add((" " * col, "text"), (mark.strip(), "ok"))

    def leave(self):
        if self.confirm.value != self.key_text.split("-")[0]:
            return t("c7_wrong")


FLOW = [Language, Hardware, Models, Network, Summary]


# ---------------------------------------------------------------------------- the program
class App:
    def __init__(self, scr, system):
        self.scr, self.system = scr, system
        self.answers = {"language": "en", "keyboard": "be", "timezone": "Europe/Brussels", "models": None}
        self.version = system.version()
        self.models, self.models_started = None, time.time()
        threading.Thread(target=self.check_models, daemon=True).start()
        self.ink = Ink()
        self.screens: dict = {}
        self.screen = None
        self.focus = 0
        self.help_open = False
        self.go(Language)

    def set_language(self, lang: str) -> None:
        global LANG
        LANG = lang

    def check_models(self):
        try:
            self.models = self.system.models()
        except Exception as e:  # noqa: BLE001 (shown, not hidden)
            self.models = [{"folder": "?", "valid": False, "error": str(e)}]

    def go(self, cls):
        # A screen keeps its fields when you come back to it; the ones after the hardware check are
        # rebuilt from the answers, which may have changed.
        if cls not in self.screens or cls in (Models, Summary, Installing, RecoveryKey):
            self.screens[cls] = cls(self)
        self.screen, self.focus, self.help_open = self.screens[cls], 0, False
        self.screen.error = ""

    def fields(self):
        return self.screen.fields()

    def top_left(self) -> str:
        return t("installer")

    def top_right(self) -> str:
        return f"{self.version} · {t('step_of', n=self.screen.step, total=STEPS)} "

    def draw(self):
        scr, ink = self.scr, self.ink
        scr.erase()
        rows, cols = scr.getmaxyx()
        def put(y, x, text, style="text", panel=False):
            if 0 <= y < rows and x < cols:
                try:
                    scr.addstr(y, max(0, x), text[: max(0, cols - x - (1 if y == rows - 1 else 0))], ink(style, panel))
                except curses.error:
                    pass
        put(0, 0, " " * cols, "bar")
        put(0, 1, "Sūveryn", "strong", True)
        put(0, 9, self.top_left(), "dim", True)
        right = self.top_right()
        put(0, cols - len(right), right, "dim", True)
        width = min(cols - 4, 92)
        c = Canvas(width - 6)
        fields = self.fields()
        focus = fields[self.focus] if fields and self.focus < len(fields) else None
        self.screen.body(c, focus)
        buttons = [f for f in fields if isinstance(f, Button)]
        if self.screen.error:
            c.blank()
            c.add((f"{WARN} ", "accent"), (self.screen.error, "accent"))
        lines = [[], *c.lines]  # a line under the title (design); the first to go on a small console
        if not buttons:
            lines.append([])  # a blank line before the bottom border, as above it
        while len(lines) + (4 if buttons else 2) > rows - 2 and [] in lines:  # a small console: fewer gaps
            lines.remove([])
        height = len(lines) + (4 if buttons else 2)
        top = max(1, (rows - height) // 2)
        left = (cols - width) // 2
        try:
            win = scr.derwin(min(height, rows - 2), width, top, left)
            win.bkgd(" ", ink("bar"))  # the window filled with #12161B
            win.attrset(ink("border"))
            win.border()
        except curses.error:
            win = None
        put(top, left + 2, f" {self.screen.title} ", "strong", True)
        for i, line in enumerate(lines):
            x = left + 3
            for text, style in line:
                put(top + 1 + i, x, text, style, True)
                x += len(text)
        if buttons:
            x = left + width - 3 - sum(len(b.label) + 3 for b in buttons)
            default = getattr(self.screen, "default", None)
            for b in buttons:
                shown = b is focus or (b is default and not isinstance(focus, Button))
                put(top + height - 2, x, b.label, "focus" if shown else "text", True)
                x += len(b.label) + 3
        if self.help_open and self.screen.help:
            # A box of its own over the window, as wide as the window's inside, so no word of the screen
            # beneath shows cut off beside it (Pod check of f0ff96c), with its title on its own border.
            hc = Canvas(width - 10)
            for para in self.screen.help.split("\n"):
                hc.wrap(para)
            hc.blank()
            hc.wrap(t("help_leave"), "dim")
            hc.wrap(t("help_close"), "dim")
            box = hc.width + 6
            hy = max(2, (rows - len(hc.lines) - 4) // 2)
            hx = left + 2
            title = f" {t('help_title')} "
            put(hy, hx, "┌─" + title + "─" * (box - 3 - len(title)) + "┐", "field")
            for i in range(len(hc.lines) + 2):
                put(hy + 1 + i, hx, "│" + " " * (box - 2) + "│", "field")
            put(hy + len(hc.lines) + 3, hx, "└" + "─" * (box - 2) + "┘", "field")
            for i, line in enumerate(hc.lines):
                x = hx + 3
                for text, style in line:
                    put(hy + 2 + i, x, text, "field")
                    x += len(text)
        put(rows - 1, 0, " " * (cols - 1), "bar")
        x = 1
        for k, v in self.screen.footer:
            if x + len(k) + 1 + len(v) > cols - 1:
                break  # a narrow console: the keys that fit, whole
            if k:
                put(rows - 1, x, k, "strong", True)
                x += len(k) + 1
            put(rows - 1, x, v, "dim", True)
            x += len(v) + 3
        scr.refresh()

    def handle(self, k):
        if self.help_open:
            if k in (27, curses.KEY_F1):
                self.help_open = False
            return
        if k == curses.KEY_F1:
            self.help_open = True
            return
        if k == 12:  # Ctrl+L
            self.scr.clear()
            return
        if isinstance(self.screen, Installing) and not self.screen.failed:
            return  # keys are disabled while installing
        fields = self.fields()
        if not fields:
            return
        self.focus = min(self.focus, len(fields) - 1)
        f = fields[self.focus]
        if isinstance(f, Select) and f.open:
            f.key(k)
            return
        if k == 9:  # Tab
            self.focus = (self.focus + 1) % len(fields)
            return
        if k == curses.KEY_BTAB:
            self.focus = (self.focus - 1) % len(fields)
            return
        if k == 27:
            self.act("back")
            return
        if isinstance(f, (Radio, Checklist)) or (isinstance(f, Select) and k in (10, 13, curses.KEY_ENTER, ord(" "))):
            if k in (10, 13, curses.KEY_ENTER) and not isinstance(f, Select):
                self.act("next")
                return
            f.key(k)
            self.screen.error = ""
            return
        if isinstance(f, Button):
            if k in (10, 13, curses.KEY_ENTER):
                self.act(f.action)
            elif k in (curses.KEY_UP, curses.KEY_LEFT):
                self.focus = (self.focus - 1) % len(fields)
            elif k in (curses.KEY_DOWN, curses.KEY_RIGHT):
                self.focus = (self.focus + 1) % len(fields)
            return
        if k in (10, 13, curses.KEY_ENTER):
            self.act("restart" if isinstance(self.screen, RecoveryKey) else "next")
            return
        if k == curses.KEY_UP:
            self.focus = (self.focus - 1) % len(fields)
            return
        if k == curses.KEY_DOWN:
            self.focus = (self.focus + 1) % len(fields)
            return
        f.key(k)
        self.screen.error = ""

    def act(self, action):
        s = self.screen
        if action == "back":
            if isinstance(s, Installing):
                self.go(Summary)
            elif not isinstance(s, (Language, RecoveryKey)):
                self.go(FLOW[FLOW.index(type(s)) - 1])
        elif action == "retry" and isinstance(s, Network):
            s.key("retry")
        elif action == "next":
            err = s.leave()
            if err:
                s.error = err
                return
            if isinstance(s, Summary):
                self.go(Installing)
            else:
                self.go(FLOW[FLOW.index(type(s)) + 1])
        elif action == "restart" and isinstance(s, RecoveryKey):
            err = s.leave()
            if err:
                s.error = err
                return
            s.error = ""
            self.draw()
            self.system.reboot()

    def run(self):
        curses.curs_set(0)
        self.scr.keypad(True)
        self.scr.timeout(500)
        while True:
            self.screen.tick()
            self.draw()
            try:
                k = self.scr.get_wch()
            except curses.error:
                continue
            # Plain ASCII as numbers (Tab 9, Enter 10, Esc 27, Space 32, Backspace 127); other letters
            # (ū, é) stay text.
            if isinstance(k, str) and len(k) == 1 and ord(k) < 128:
                k = ord(k)
            self.handle(k)


def main() -> int:
    os.environ.setdefault("ESCDELAY", "50")
    fake = os.environ.get("SUVERYN_INSTALLER_FAKE")
    system = FakeSystem(fake) if fake else RealSystem()
    if not fake and Path("/run/suveryn/boot-mode").read_text().strip() != "installer":
        print("installer-ui: this system didn't start from the installer stick", file=sys.stderr)
        return 2
    import locale
    locale.setlocale(locale.LC_ALL, "C.UTF-8")
    curses.wrapper(lambda scr: App(scr, system).run())
    return 0


if __name__ == "__main__":
    sys.exit(main())
