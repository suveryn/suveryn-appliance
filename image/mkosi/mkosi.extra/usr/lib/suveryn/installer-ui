class Hardware(Screen):
    title_key, help_key, step = "c2_title", "c2_help", 2

    def __init__(self, app):
        super().__init__(app)
        self.hw = app.system.hardware()
        boot = app.system.boot_disk()
        self.min = app.system.min_disk()
        self.disks = [d for d in app.system.disks() if d["name"] != boot]
        self.stick = next((d for d in app.system.disks() if d["name"] == boot), None)
        options, disabled = [], []
        for d in self.disks:
            small = d["size"] < self.min
            options.append((d["name"], lambda d=d, small=small: f"{d['name']:<10} {(d['model'] or t('c2_disk'))[:24]:<25} "
                            f"{gb(d['size'])}" + (f"  {t('c2_too_small')}" if small else "")))
            if small:
                disabled.append(d["name"])
        self.disk = Radio("", options, app.answers.get("disk"), disabled=disabled)
        self.back, self.next = Button(lambda: t("button_back"), "back"), Button(lambda: t("button_next"), "next")

    def problems(self) -> tuple[list, list]:
        """(blocking, warnings) as lines for the hardware check."""
        hw, block, warn = self.hw, [], []
        if not hw["gpu"] and os.environ.get("SUVERYN_INSTALLER_ALLOW_NO_GPU") != "1":
            block.append(t("c2_block_gpu"))
        if not hw["tpm"]:
            block.append(t("c2_block_tpm"))
        if not self.disk.value:
            block.append(t("c2_block_disk", size=gb(self.min)))
        return block, warn

    def fields(self):
        return [self.disk, self.back, self.next]

    def body(self, c, focus):
        hw = self.hw
        c.add((t("c2_check"), "strong"))
        def row(ok, label, value, note=None):
            c.add((f"  {CHECK if ok else WARN} ", "ok" if ok else "accent"), (label.ljust(18), "dim"), (value, "text"))
            if note:
                c.add((" " * 22, "text"), (note, "dim"))
        g = hw["gpu"]
        if g:
            mem = f" · {gb_whole(g['memory_gb'])}" if g.get("memory_gb") else ""
            ok = not g.get("memory_gb") or g["memory_gb"] >= MIN_GPU_GB
            row(ok, t("c2_graphics"), g["name"] + mem,
                t("c2_geforce") if "GeForce" in g["name"] else (None if ok else t("c2_gpu_memory_low", gb=MIN_GPU_GB)))
        else:
            row(False, t("c2_graphics"), t("c2_no_gpu"))
        row(True, t("c2_processor"), t("c2_cores", n=hw["cores"]))
        row(hw["tpm"], t("c2_security"), t("c2_tpm_ok") if hw["tpm"] else t("c2_no_tpm"))
        mem_ok = hw["memory_gb"] >= RECOMMENDED_MEMORY_GB
        row(mem_ok, t("c2_memory"), gb_whole(hw["memory_gb"]) if mem_ok else
            t("c2_memory_low", gb=hw["memory_gb"], rec=RECOMMENDED_MEMORY_GB), None if mem_ok else t("c2_memory_note"))
        c.blank()
        c.add((t("c2_install_to"), "strong"))
        self.disk.draw(c, focus is self.disk, 0)
        if self.stick:
            c.add((f"     {self.stick['name']:<10} {t('c2_stick')[:24]:<25} {gb(self.stick['size'])}", "dim"))
            c.add((" " * 41, "text"), (t("c2_medium"), "dim"))
        c.blank()
        c.add((f"{WARN} ", "accent"), (t("c2_erased"), "text"))

    def leave(self):
        block, _ = self.problems()
        if block:
            return block[0]
        d = next(d for d in self.disks if d["name"] == self.disk.value)
        self.app.answers.update(disk=d["name"], disk_size=d["size"], disk_model=d["model"], hardware=self.hw)


def model_problem(error: str) -> str:
    if "SHA-256" in error or "bytes, the manifest says" in error or "missing" in error:
        return t("c3_changed")
    if "trust" in error or "signature" in error or "signed" in error:
        return t("c3_bad_signature")
    return error[:60]


class Models(Screen):
    title_key, help_key, step = "c3_title", "c3_help", 3
    keys = [("↑↓", "key_move"), ("Space", "key_select"), ("Tab", "key_next_field"), ("Enter", "key_continue"),
            ("Esc", "key_back")]

    def __init__(self, app):
        super().__init__(app)
        self.list = None
        self.back, self.next = Button(lambda: t("button_back"), "back"), Button(lambda: t("button_next"), "next")
        self.build()

    def build(self):
        models = self.app.models
        if models is None:
            return
        chosen = self.app.answers.get("models")
        items = []
        for m in models:
            if m.get("valid"):
                checked = (m["folder"] in chosen) if chosen is not None else bool(m.get("default"))
                items.append({"folder": m["folder"], "label": m.get("title") or m["name"],
                              "middle": f"{t('c3_default') if m.get('default') else t('c3_optional')} · {gb(m['size'])}",
                              "right": "", "size": m["size"],
                              "note": m.get(f"description_{LANG}") or m.get("description", ""),
                              "enabled": True, "checked": checked})
            else:
                items.append({"folder": m["folder"], "label": m["folder"], "middle": "",
                              "right": f"{WARN} {t('c3_skipped')}", "right_style": "accent", "enabled": False,
                              "checked": False, "note": [(model_problem(m.get("error", "")) + " ", "accent"),
                                                         (t("c3_not_installed"), "dim")]})
        self.list = Checklist(items)

    def tick(self):
        if self.list is None and self.app.models is not None:
            self.build()
            return True
        return self.list is None

    def free(self) -> int:
        return self.app.answers.get("disk_size", 0) - self.app.system.min_disk()

    def fields(self):
        return ([self.list] if self.list and any(i["enabled"] for i in self.list.items) else []) + [self.back, self.next]

    def body(self, c, focus):
        if self.list is None:
            c.add((t("c3_checking"), "strong"))
            c.wrap(t("c3_checking_note", s=int(time.time() - self.app.models_started)), "dim")
            return
        valid = [m for m in self.app.models if m.get("valid")]
        c.add((t("c3_found"), "strong"))
        c.add((t("c3_partition", disk=self.app.system.boot_disk()), "dim"))
        if valid:
            keys = sorted({m["key"][:16] for m in valid})
            c.add((f"{CHECK} ", "ok"), (t("c3_signed"), "text"), (", ".join(keys), "strong"))
            c.add(("  " + t("c3_key_matches"), "dim"))
        else:
            c.add((f"{WARN} ", "accent"), (t("c3_none_valid"), "text"))
        c.blank()
        used = 0
        for it in self.list.items:
            if it["enabled"]:
                used += it["size"] if it["checked"] else 0
                fits = used <= self.free() or not it["checked"]
                it["right"], it["right_style"] = (f"{CHECK} {t('c3_fits')}", "ok") if fits else \
                    (f"{WARN} {t('c3_too_big')}", "accent")
        self.list.draw(c, focus is self.list, 0)
        c.add(("─" * c.width, "dim"))
        chosen = [it for it in self.list.items if it["checked"]]
        g = self.app.answers.get("hardware", {}).get("gpu")
        if g and g.get("memory_gb"):
            c.add((t("c3_graphics").ljust(18), "dim"), (t("c3_graphics_note", gb=g["memory_gb"]), "text"))
        disk = self.app.answers.get("disk", "")
        c.add((t("c3_disk").ljust(18), "dim"),
              (t("c3_disk_one" if len(chosen) == 1 else "c3_disk_many", n=len(chosen), used=gb(used),
                 size=gb(self.app.answers.get("disk_size", 0)), disk=disk), "text"))

    def leave(self):
        if self.list is None:
            return t("c3_still_checking")
        chosen = [it for it in self.list.items if it["checked"]]
        if any(it["enabled"] for it in self.list.items) and not chosen:
            return t("c3_choose_one")
        if sum(it["size"] for it in chosen) > self.free():
            return t("c3_dont_fit")
        self.app.answers["models"] = [it["folder"] for it in chosen]
        self.app.answers["model_titles"] = [it["label"] for it in chosen]


class Network(Screen):
    title_key, help_key, step = "c4_title", "c4_help", 4

    def __init__(self, app):
        super().__init__(app)
        a = app.answers
        self.ports = app.system.interfaces()
        opts = []
        def state(p):
            if p["carrier"] and p["speed"] > 0:
                fast = p["speed"] >= 1000
                return f"{t('c4_connected')} · {p['speed'] // 1000 if fast else p['speed']} {'Gbit/s' if fast else 'Mbit/s'}"
            return t("c4_connected") if p["carrier"] else t("c4_no_cable")
        for p in self.ports:
            opts.append((p["name"], lambda p=p: f"{p['name']:<9} {p['model'][:18]:<19} {state(p)}"))
        first = next((p["name"] for p in self.ports if p["carrier"]), self.ports[0]["name"] if self.ports else None)
        self.port = Radio(lambda: t("c4_interface"), opts, a.get("interface") or first,
                          on_change=lambda v: self.restart_dhcp())
        self.name = Text(lambda: t("c4_name"), a.get("name", ""), placeholder=lambda: t("c4_name_placeholder"),
                         hint=lambda: t("c4_name_hint", name=self.name.value or t("c4_name_word")))
        self.mode = Radio(lambda: t("c4_address"), [("dhcp", lambda: t("c4_dhcp")), ("fixed", lambda: t("c4_fixed"))],
                          a.get("address_mode", "dhcp"), inline=True)
        self.ip = Text(lambda: t("c4_ip"), a.get("fixed_address", ""), placeholder="192.168.1.50/24", width=24)
        self.gw = Text(lambda: t("c4_gateway"), a.get("fixed_gateway", ""), placeholder="192.168.1.1", width=24)
        self.dns = Text(lambda: t("c4_dns"), a.get("fixed_dns", ""), placeholder="192.168.1.1", width=24)
        self.back, self.retry, self.next = (Button(lambda: t("button_back"), "back"),
                                            Button(lambda: t("button_retry_dhcp"), "retry"),
                                            Button(lambda: t("button_next"), "next"))
        self.lease, self.timed_out = None, False
        self.restart_dhcp()

    def restart_dhcp(self):
        self.lease, self.timed_out, self.dhcp_started = None, False, time.time()

    def tick(self):
        if self.mode.value != "dhcp" and not self.timed_out:
            return False
        if self.lease is None and self.port.value and not self.timed_out:
            self.lease = self.app.system.dhcp(self.port.value)
            if self.lease is None and time.time() - self.dhcp_started > DHCP_WAIT:
                self.timed_out = True
                self.mode.value = "fixed"
            return True
        return False

    def fields(self):
        f = [self.port, self.name, self.mode]
        if self.mode.value == "fixed":
            f += [self.ip, self.gw, self.dns]
        return f + [self.back] + ([self.retry] if self.timed_out else []) + [self.next]

    def body(self, c, focus):
        self.port.draw(c, focus is self.port, 16)
        c.blank()
        self.name.draw(c, focus is self.name, 16)
        c.blank()
        self.mode.draw(c, focus is self.mode, 16)
        if self.mode.value == "dhcp":
            if self.lease:
                c.add((" " * 16, "text"), (f"{CHECK} ", "ok"), (t("c4_received", address=self.lease["address"]), "text"))
                extra = " · ".join(x for x in (t("c4_gateway_is", gw=self.lease["gateway"]) if self.lease.get("gateway") else "",
                                               f"DNS {', '.join(self.lease['dns'])}" if self.lease.get("dns") else "") if x)
                if extra:
                    c.add((" " * 18, "text"), (extra, "dim"))
            else:
                c.add((" " * 16, "text"), (t("c4_waiting", s=int(time.time() - self.dhcp_started)), "dim"))
            c.blank()
            c.wrap(t("c4_reserve"), "dim")
        else:
            if self.timed_out:
                c.add((" " * 16, "text"), (f"{WARN} ", "accent"), (t("c4_no_lease", s=DHCP_WAIT), "text"))
                c.add((" " * 18, "text"), (t("c4_check_cable"), "dim"))
            c.blank()
            for f in (self.ip, self.gw, self.dns):
                f.draw(c, focus is f, 16)
            c.blank()
            c.wrap(t("c4_free_address"), "dim")

    def leave(self):
        try:
            ENGINE.check_name(self.name.value)
        except ENGINE.Refused:
            return t("c4_bad_name")
        if not self.port.value:
            return t("c4_no_port")
        args = Namespace(interface=self.port.value, address="dhcp", gateway=None, dns=None)
        if self.mode.value == "fixed":
            args = Namespace(interface=self.port.value, address=self.ip.value.strip(),
                             gateway=self.gw.value.strip() or None, dns=self.dns.value.strip() or None)
        try:
            ENGINE.network_file(args, ports={p["name"]: p["mac"] for p in self.ports})
        except ENGINE.Refused as e:
            return network_problem(str(e), args)
        self.app.answers.update(interface=self.port.value, name=self.name.value, address_mode=self.mode.value,
                                fixed_address=self.ip.value.strip(), fixed_gateway=self.gw.value.strip(),
                                fixed_dns=self.dns.value.strip(), lease=self.lease)

    def key(self, k):
        if k == "retry":
            self.mode.value = "dhcp"
            self.restart_dhcp()
            return True
        return False


def network_problem(error: str, args) -> str:
    """The installer's check of a fixed address, in the chosen language."""
    if "network prefix" in error:
        return t("c4_need_prefix")
    m = re.search(r"the gateway (\S+) isn't in (\S+)", error)
    if m:
        return t("c4_gateway_outside", gw=m.group(1), net=m.group(2))
    if "DNS server" in error:
        return t("c4_need_dns")
    return t("c4_bad_address", detail=error.removeprefix("unusable address: "))


