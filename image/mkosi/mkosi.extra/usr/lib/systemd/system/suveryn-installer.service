[Unit]
Description=sūveryn installer on the console (installer stick only)
Documentation=file:/usr/lib/suveryn/installer-ui
# Only when the system started from the installer stick (suveryn-boot-mode, in the initrd).
ConditionPathExists=/run/suveryn/installer-mode
After=systemd-user-sessions.service systemd-networkd.service console-setup.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
# The brand's colours on the console, and kernel messages kept off the screens.
ExecStartPre=-/usr/sbin/setvtrgb /usr/lib/suveryn/console-colours
ExecStartPre=-/usr/bin/dmesg --console-level err
ExecStart=/usr/lib/suveryn/installer-ui
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux ESCDELAY=50
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
