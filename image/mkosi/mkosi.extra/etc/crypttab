# The data partition (#34): unlocked by the TPM (PCR 7) at boot; if that fails, the console asks for
# the recovery key: 5 typed attempts. systemd counts the failed TPM attempt as one of the tries,
# hence tries=6. Same line as the system's own /etc/crypttab.
suveryn-data  PARTLABEL=suveryn-data  -  tpm2-device=auto,tries=6,x-initrd.attach
