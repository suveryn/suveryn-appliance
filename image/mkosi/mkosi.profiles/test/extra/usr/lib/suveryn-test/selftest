#!/bin/bash
# Runs once per boot in the test system, prints one line per rule of the design note and a result
# line to the serial console (image/mkosi/test/run-vm-tests reads them), then powers off.
#
# Mode, from the credential suveryn.test (QEMU: -smbios type=11,value=io.systemd.credential:suveryn.test=…):
#   install-checks   started from the installer stick (/dev/vda): check installer mode, the stick's
#                    bundles, and that a bad name and a changed bundle are refused, writing nothing on
#                    the empty second disk (/dev/vdb). The installation itself is done through the
#                    console installer (run-vm-tests drives it on the serial console)
#   first-boot       the installed system's first start: also the installer's firmware boot entry
#   stick-beside     started from the stick, with an installed appliance as the second disk: installer
#                    mode, and that appliance's data partition is never opened
#   tpm-replaced     check the running system; the identity, sealed to the old TPM, must be unusable;
#                    the data partition opened with the recovery key (C8b) and the TPM enrolled again
#   tpm-again        the next start with that TPM: unlocked by the TPM again, without a prompt
#   web-setup        the web setup (#37): open, then (run-vm-tests drives its screens from a browser
#                    through a forwarded port) wait until it has closed, and check what it left
#   (none)           check the running system (the installed appliance)
out=/dev/ttyS0
say() { echo "SUVERYN-SELFTEST $*" > "$out"; }
fails=0
check() {  # check <name> <command…>: ok when the command succeeds
  local name=$1; shift
  if detail=$("$@" 2>&1); then say "ok   $name${detail:+: $detail}"; else say "FAIL $name${detail:+: $detail}"; fails=$((fails+1)); fi
}
finish() {
  say "boot-id $(cat /proc/sys/kernel/random/boot_id)"
  if [ "$fails" -eq 0 ]; then say "RESULT PASS"; else say "RESULT FAIL ($fails)"; fi
  systemctl --no-block poweroff
  exit 0
}
mode=$(cat /run/credentials/@system/suveryn.test 2>/dev/null)

root_on_boot_disk() {  # slot A (the verified root) comes from the disk the firmware started from
  check "root from the boot disk"      bash -c 'd=$(ls /sys/block/$(basename "$(readlink -f /dev/mapper/root)")/slaves | head -1); disk=/dev/$(basename "$(readlink -f /sys/class/block/$d/..)"); echo "$d on $disk"; test "$disk" = "$(cat /run/suveryn/boot-disk)"'
}

installer_checks() {
  root_on_boot_disk
  check "installer mode: /var in memory" bash -c 'test "$(cat /run/suveryn/boot-mode)" = installer && test "$(findmnt -no FSTYPE /var)" = tmpfs && echo "boot disk $(cat /run/suveryn/boot-disk)"'
  check "no data partition opened"     bash -c '! cryptsetup status suveryn-data >/dev/null 2>&1 && ! ls /dev/mapper | grep -q suveryn'
  check "no identity on the stick"     test ! -e /var/lib/suveryn/identity
}

if [ "$mode" = stick-beside ]; then
  installer_checks
  check "started from the stick"       test "$(cat /run/suveryn/boot-disk)" = /dev/vda
  finish
fi

if [ "$mode" = install-checks ]; then
  installer_checks
  check "stick's bundles checked"      python3 -c '
import json, subprocess
m = {x["folder"]: x for x in json.loads(subprocess.run(["/usr/lib/suveryn/install", "--list-models", "--json"],
                                                       capture_output=True, text=True, check=True).stdout)}
assert m["good"]["valid"] and m["good"]["name"] == "test-model", m
assert not m["changed"]["valid"] and "SHA-256" in m["changed"]["error"], m
assert not m["untrusted"]["valid"] and "trust" in m["untrusted"]["error"], m
print("good valid; changed and untrusted refused")'
  # The stick's partition table: the primary GPT (first 34 sectors) and the backup (last 33).
  gpt() { s=$(blockdev --getsz /dev/vda) && { dd if=/dev/vda bs=512 count=34 status=none; dd if=/dev/vda bs=512 skip=$((s-33)) status=none; } | sha256sum | cut -c1-16; }
  gpt > /run/stick-before.gpt
  empty() { test -z "$(dd if=/dev/vdb bs=1M count=1 status=none | tr -d '\0' | head -c1)"; }
  refused() {  # refused <install arguments…>: exit 2, its message, and the disk still empty
    /usr/lib/suveryn/install --disk /dev/vdb "$@" > /run/refused.out 2>&1; r=$?
    tail -1 /run/refused.out; [ "$r" -eq 2 ] && empty
  }
  check "a bad name is refused, nothing written"       refused --name 'Not_A-Name-'
  check "a changed bundle is refused, nothing written" refused --name test-appliance --model changed
  check "the stick is untouched" bash -c "b=\$(cat /run/stick-before.gpt); a=\$($(declare -f gpt); gpt); [ \${#b} -eq 16 ] && [ \"\$a\" = \"\$b\" ] && echo \"partition table \$a\""
  finish
fi

root_on_boot_disk
case "$mode" in
  tpm-replaced) check "opened with the recovery key, TPM enrolled again" bash -c 'test "$(cat /run/suveryn/unlocked-by)" = recovery-key && test -e /run/suveryn/tpm-enrolled && cryptsetup luksDump "$(cat /run/suveryn/data-partition)" | grep -c systemd-tpm2' ;;
  *) check "unlocked by the TPM"     bash -c 'test "$(cat /run/suveryn/unlocked-by)" = tpm' ;;
esac
check "mDNS: answers for <name>.local" bash -c 'i=$(ls /sys/class/net | grep -v "^lo$" | head -1); resolvectl status "$i" | grep -q "+mDNS" && ss -uln | grep -q ":5353 " && echo "$(hostname).local on $i"'
check "installed mode, own disk"      bash -c 'test "$(cat /run/suveryn/boot-mode)" = installed && d=$(cat /run/suveryn/data-partition) && case "$d" in "$(cat /run/suveryn/boot-disk)"*) echo "data $d on boot disk $(cat /run/suveryn/boot-disk)";; *) exit 1;; esac'
check "root from the verity device"   test "$(findmnt -no SOURCE /)" = /dev/mapper/root
check "root mounted read-only"        sh -c 'findmnt -no OPTIONS / | grep -qw ro && echo "$(findmnt -no FSTYPE /)"'
check "root can't be written"         sh -c '! touch /usr/suveryn-write-test 2>/dev/null'
check "root hash from the boot file"  bash -c 'h=$(sed -n "s/.*roothash=\([0-9a-f]*\).*/\1/p" /proc/cmdline); [ -n "$h" ] && veritysetup status root | grep -q "$h" && echo "${h:0:16}…"'
check "verity reports verified"       sh -c 'veritysetup status root | grep -E "^ +status:" | grep -q verified'
check "/var on the encrypted data partition" bash -c 'src=$(findmnt -no SOURCE /var); st=$(cryptsetup status suveryn-data 2>&1); type=$(echo "$st" | sed -n "s/^ *type: *//p"); dev=$(echo "$st" | sed -n "s/^ *device: *//p"); label=$(sed -n "s/^PARTNAME=//p" "/sys/class/block/$(basename "$dev")/uevent"); echo "source $src, $type on $dev ($label)"; [ "$src" = /dev/mapper/suveryn-data ] && [ "$type" = LUKS2 ] && [ "$label" = suveryn-data ]'
check "/var noexec,nosuid,nodev"      sh -c 'o=$(findmnt -no OPTIONS /var); for f in noexec nosuid nodev; do echo "$o" | grep -qw $f || exit 1; done'
check "nothing runs from /var"        sh -c 'cp /usr/bin/true /var/tmp/x && ! /var/tmp/x 2>/dev/null; r=$?; rm -f /var/tmp/x; exit $r'
check "/tmp in memory"                sh -c 'test "$(findmnt -no FSTYPE /tmp)" = tmpfs'
check "no swap"                       sh -c 'test -z "$(swapon --noheadings)"'
check "/etc/suveryn on /var"          sh -c 'test "$(readlink -f /etc/suveryn)" = /var/lib/suveryn/etc && test -d /etc/suveryn'
check "/etc/hosts on /var"            sh -c 'test "$(readlink -f /etc/hosts)" = /var/lib/suveryn/host/hosts && grep -q localhost /etc/hosts'
check "machine-id kept on /var"       sh -c 'id=$(cat /var/lib/suveryn/host/machine-id) && [ ${#id} -eq 32 ] && [ "$id" = "$(cat /etc/machine-id)" ] && echo "$id"'
check "image /var restored"           test -d /var/lib/systemd
check "every root block readable"     sh -c 'dd if=/dev/block/$(findmnt -no MAJ:MIN /) of=/dev/null bs=1M status=none'
# The identity (#35): made at first boot, sealed to this TPM, never stored in plain form.
id=/usr/lib/suveryn/identity; iddir=/var/lib/suveryn/identity
say "identity $(python3 -c 'import json; d=json.load(open("/var/lib/suveryn/identity/identity.json")); print(d["uuid"], d["fingerprint"])' 2>/dev/null)"
check "identity made at first boot"   python3 -c '
import json, re, uuid
d = json.load(open("/var/lib/suveryn/identity/identity.json"))
assert uuid.UUID(d["uuid"]).version == 4 and open("/var/lib/suveryn/identity/uuid").read().strip() == d["uuid"]
assert re.fullmatch("[0-9a-f]{64}", d["fingerprint"]) and d["algorithm"] == "ed25519"
assert open("/var/lib/suveryn/identity/public.pem").read() == d["public_key"]
print(d["uuid"])'
check "fingerprint is the key's"      bash -c "f=\$(openssl pkey -pubin -in $iddir/public.pem -outform DER | tail -c 32 | sha256sum | cut -c1-64); grep -q \"\$f\" $iddir/identity.json && echo \${f:0:16}…"
check "private key not stored plain"  bash -c "test \"\$(stat -c %a $iddir/private.cred)\" = 600 && ! grep -qa 'PRIVATE KEY' $iddir/private.cred && ! openssl pkey -in $iddir/private.cred -noout 2>/dev/null && ! grep -rqa 'PRIVATE KEY' $iddir && ! grep -rla 'PRIVATE KEY' /var/lib/suveryn/etc | grep -vx '/var/lib/suveryn/etc/tls/\\(ca\\|server\\)\\.key'"
if [ "$mode" = tpm-replaced ] || [ "$mode" = tpm-again ]; then
  check "identity sealed to the TPM"  bash -c "grep -q '\"sealed\": \"host+tpm2\"' $iddir/identity.json"
  check "identity unusable with another TPM" bash -c "! $id show >/tmp/show 2>&1 && grep -q 'Usable: *NO' /tmp/show && ! $id sign /etc/os-release >/dev/null 2>&1 && echo refused"
  check "identity not replaced"       bash -c "test \$(ls $iddir | wc -l) -eq 4"
else
  check "identity sealed to the TPM"  bash -c "grep -q '\"sealed\": \"host+tpm2\"' $iddir/identity.json"
  check "identity signs and verifies" bash -c "$id show | grep -q 'Usable: *yes' && $id sign /etc/os-release > /tmp/sig && $id verify /etc/os-release /tmp/sig && echo 'x' > /tmp/other && ! $id verify /tmp/other /tmp/sig >/dev/null"
  check "signature checks with openssl" bash -c "base64 -d /tmp/sig > /tmp/sig.bin && openssl pkeyutl -verify -pubin -inkey $iddir/public.pem -rawin -in /etc/os-release -sigfile /tmp/sig.bin"
fi
# The system state the appliance reports (#35, "system intact").
check "system state reported"         python3 -c '
import json, re, subprocess
r = subprocess.run(["/usr/lib/suveryn/system-state", "--json"], capture_output=True, text=True)
s = json.loads(r.stdout)
h = re.search(r"roothash=([0-9a-f]{64})", open("/proc/cmdline").read()).group(1)
assert r.returncode == 0 and s["verity_intact"], s
assert s["image"] == {"id": "suveryn-test", "version": "0.0.0"}, s["image"]
assert s["roothash"] == h and s["verity"] == {"active": True, "status": "verified", "matches_roothash": True}, s
assert s["slot"] and s["slot"].startswith("suveryn"), s["slot"]
assert re.fullmatch("[0-9a-f]{64}", s["pcr11"] or ""), s["pcr11"]
assert s["identity"]["uuid"] == open("/var/lib/suveryn/identity/uuid").read().strip()
img = s["image"]
print("%s %s, slot %s, PCR 11 %s..." % (img["id"], img["version"], s["slot"], s["pcr11"][:16]))'
# Signed bundles (#36): the one the installer put on the data partition.
bundle=/usr/lib/suveryn/bundle; installed=/var/lib/suveryn/bundles/model/test-model/1.0
check "two bundle keys trusted"       bash -c "test \$($bundle keys | wc -l) -eq 2 && $bundle keys | cut -c1-16 | tr '\n' ' '"
check "the installer's settings"     bash -c 'test "$(hostname)" = test-appliance && test "$(readlink -f /etc/localtime)" = /usr/share/zoneinfo/Europe/Brussels && grep -q "^MACAddress=" /etc/systemd/network/10-suveryn.network && python3 -c "import json; d=json.load(open(\"/var/lib/suveryn/installed.json\")); assert d[\"name\"] == \"test-appliance\"" && echo "$(hostname), $(date +%Z)"'
check "the installer's network file in use" bash -c 'i=$(ls /sys/class/net | grep -v "^lo$" | head -1); for n in $(seq 30); do f=$(networkctl status --no-pager "$i" 2>/dev/null | sed -n "s/^ *Network File: //p"); [ -n "$f" ] && break; sleep 1; done; echo "$i: $f"; test "$(readlink -f "$f")" = "$(readlink -f /etc/systemd/network/10-suveryn.network)"'
check "the installer's keyboard layout" grep -q '^XKBLAYOUT="be"' /etc/default/keyboard
check "the console's font and layout set" bash -c 'systemctl is-active console-setup.service || { journalctl -b -u console-setup --no-pager | tail -3; exit 1; }'
check "the installer's language"      python3 -c 'import json; d = json.load(open("/var/lib/suveryn/installed.json")); assert d["language"] == "nl", d; print(d["language"])'
if [ "$mode" = first-boot ]; then
  check "the installer's boot entry"   bash -c 'efibootmgr | grep -i suveryn && efibootmgr | sed -n "s/^BootOrder: //p"'
fi
check "installed bundle verifies"     bash -c "$bundle verify $installed 2>/dev/null | grep -q '^valid:' && echo \$(du -sh $installed | cut -f1)"
# The web setup (#37): open until setup is complete, then closed for good.
setup_open() {
  check "web setup open: its service up, unprivileged" bash -c 'for i in $(seq 180); do systemctl is-active --quiet suveryn-setup.service && break; sleep 1; done
    pid=$(systemctl show -p MainPID --value suveryn-setup.service); u=$(id -nu "$(sed -n "s/^Uid:\t\([0-9]*\).*/\1/p" /proc/$pid/status)"); cap=$(sed -n "s/^CapEff:\t//p" /proc/$pid/status)
    echo "pid $pid as $u, capabilities $cap"; [ "$u" = suveryn-setup ] && [ "$cap" = 0000000000000000 ]'
  check "web setup open: the page at /, the API answers" python3 -c '
import subprocess
out = subprocess.run(["/usr/lib/suveryn-test/web-get", "--wait-for", "setup", "/", "/setup/v1/state"], capture_output=True, text=True).stdout.split("\n")
print("; ".join(out[:2]))
assert out[0].startswith("/ 200 ") and "setup" in out[0] and out[1].startswith("/setup/v1/state 200"), out'
  check "web setup open: it sees the address, name and identity" /usr/lib/suveryn-test/setup-state
  check "web setup open: its certificate for the console" bash -c 'openssl x509 -in /etc/suveryn/tls/setup-cert.pem -noout -ext subjectAltName | grep -q "DNS:$(hostname).local" && openssl x509 -in /etc/suveryn/tls/setup-cert.pem -noout -fingerprint -sha256 | cut -c1-40'
  check "web setup open: answers folder 0700, its own" bash -c 'test "$(stat -c "%a %U" /var/lib/suveryn/setup/answers)" = "700 suveryn-setup"'
}
setup_closed() {
  check "web setup closed: units stopped, not started again" bash -c '! systemctl is-active --quiet suveryn-setup.service && ! systemctl is-active --quiet suveryn-setup-provision.path && cat /etc/suveryn/setup-complete'
  check "web setup closed: / is the chat, /setup/ is gone" python3 -c '
import subprocess
out = subprocess.run(["/usr/lib/suveryn-test/web-get", "/", "/setup/v1/state", "/setup.html"], capture_output=True, text=True).stdout.split("\n")
print("; ".join(out[:3]))
assert out[0].startswith("/ 200 ") and "etup" not in out[0], out
assert out[1] == "/setup/v1/state 404 " or out[1].startswith("/setup/v1/state 404"), out
assert out[2].startswith("/setup.html 404"), out'
  check "web setup closed: answers and secrets gone, choices kept" python3 -c '
import json, os, stat
assert not os.path.exists("/var/lib/suveryn/setup/answers") and not os.path.exists("/etc/suveryn/nginx-setup.conf")
assert not os.path.exists("/etc/suveryn/tls/setup-cert.pem")
kept = json.load(open("/etc/suveryn/setup-answers.json"))
assert set(kept["administrator"]) == {"name", "email"} and kept["support"]["edition"] == "Sūveryn Enterprise", kept
assert stat.S_IMODE(os.stat("/etc/suveryn/backups-share.secret").st_mode) == 0o600
assert json.load(open("/etc/suveryn/backups.json"))["recipient"].startswith("age1")
print(kept["administrator"]["email"], kept["backups"]["target"], kept["completed"])'
}
if [ "$mode" = web-setup ]; then
  setup_open
  say "web-setup ready"
  check "web setup: completed from the browser" bash -c 'for i in $(seq 2400); do test -e /etc/suveryn/setup-complete && ! systemctl is-active --quiet suveryn-setup.service && exit 0; sleep 1; done; journalctl -b -u suveryn-setup -u suveryn-setup-provision --no-pager | tail -5; exit 1'
  sleep 3
  setup_closed
elif [ -e /etc/suveryn/setup-complete ]; then
  setup_closed
else
  setup_open
fi
check "network up (DHCP)"             sh -c 'for i in $(seq 60); do ip -4 -o addr show scope global | grep -q inet && exit 0; sleep 1; done; networkctl --no-pager --no-legend 2>&1 | tr "\n" ";"; systemctl is-active systemd-networkd; exit 1'
finish
