[Unit]
Description=sūveryn test system: check the read-only system's rules (test profile only)
After=multi-user.target systemd-tmpfiles-setup.service systemd-networkd.service suveryn-identity.service
# Not while the console installer has the serial console (run-vm-tests step 1).
ConditionCredential=!suveryn.installer-on-serial

[Service]
Type=oneshot
ExecStart=/usr/lib/suveryn-test/selftest

[Install]
WantedBy=multi-user.target
