#!/bin/bash
# C8b, "Boot · Disk won't unlock" (#37, #34): in the initrd, when the TPM can't open the data partition.
#
#   unlock-screen /dev/<data partition>
#
# Asks for the recovery key on the console, five attempts. Dashes and capitals are optional. Once the
# key opens the disk, the TPM is enrolled again (PCR 7, as at installation), so the next start is
# unattended. After five wrong keys it says what that means and waits: Ctrl+Alt+Del restarts.
#
# The office's language isn't known yet (it is on the locked disk), so the screen is in English with
# the essential lines in Dutch and French too. The key itself only passes through a file in /run (the
# initrd's memory), removed as soon as it has been tried.
set -uo pipefail

DATA=${1:?usage: unlock-screen /dev/<data partition>}
NAME=suveryn-data
TRIES=5
KEY=/run/suveryn/.recovery-key
CON=/dev/console
MODHEX='^[cbdefghijklnrtuv]{64}$'

exec <"$CON" >"$CON" 2>&1
umask 077
mkdir -p /run/suveryn

# The console as on the appliance: the brand's colours and a font with ū, where there is a screen.
setvtrgb /usr/lib/suveryn/console-colours 2>/dev/null
setfont /usr/share/consolefonts/Vietnamese-Terminus16.psf.gz 2>/dev/null
dmesg --console-level emerg 2>/dev/null
kill -s RTMIN+21 1 2>/dev/null  # systemd's own status lines would draw over this screen
restore() { stty sane 2>/dev/null; kill -s RTMIN+20 1 2>/dev/null; }
trap restore EXIT

# Colours: 1 accent, 6 teal, 7 grey, 15 text; on a black background.
A=$'\e[1;31m' T=$'\e[1;36m' D=$'\e[0;37m' B=$'\e[1;37m' R=$'\e[0m' F=$'\e[44;1;37m'
cols=$(tput cols 2>/dev/null || echo 80)
[ "$cols" -gt 20 ] 2>/dev/null || cols=80
version=$(sed -n 's/^IMAGE_VERSION=//p' /sysroot/usr/lib/os-release 2>/dev/null)

# The screen as designed (console-08b): the bars full width, the text wrapped to the console's width
# (never inside a word, also at 80 columns), the keys in the bottom bar, the field's brackets in
# accent (Pod check of 7c48279). The host name is on the locked disk, so the top bar has none.
rows=$(tput lines 2>/dev/null || echo 25)
[ "$rows" -gt 10 ] 2>/dev/null || rows=25
row=1    # the line the next say() writes
field=0  # the input field's line

say() {  # say <colour> <text> [indent] [first]: the text wrapped at word boundaries, <indent> columns
  # in; <first> (as wide as the indent) begins the first line instead of spaces, such as "  ! "
  local colour=$1 text=$2 indent=${3:-2} first=${4:-} width=$((cols - ${3:-2} - 2)) line="" w
  local lead=${first:-$(printf '%*s' "$indent" "")}
  for w in $text; do
    if [ -n "$line" ] && [ $(( ${#line} + 1 + ${#w} )) -gt "$width" ]; then
      printf '%s%s%s%s\n' "$lead" "$colour" "$line" "$R"; row=$((row + 1)); line=$w
      lead=$(printf '%*s' "$indent" "")
    else
      line=${line:+$line }$w
    fi
  done
  [ -n "$line" ] && { printf '%s%s%s%s\n' "$lead" "$colour" "$line" "$R"; row=$((row + 1)); }
}
gap() { [ "$rows" -ge 30 ] || return 0; printf '\n'; row=$((row + 1)); }  # no blank lines on a 25-line console: it all fits

bars() {  # the top bar, and the bottom bar with the keys: bars <key> <what> [<key> <what>]
  local right="tty1" x=2
  printf '\e[0m\e[2J\e[H\e[45;1;37m Sūveryn\e[22m %s%*s%s \e[0m' "$version" \
    $((cols - 10 - ${#version} - ${#right})) "" "$right"
  printf '\e[%d;1H\e[45m%*s' "$rows" $((cols - 1)) ""  # the last cell can't be written without scrolling
  while [ $# -ge 2 ]; do
    printf '\e[%d;%dH\e[45;1;37m%s\e[22;37m %s' "$rows" "$x" "$1" "$2"
    x=$((x + ${#1} + ${#2} + 4)); shift 2
  done
  printf '\e[0m\e[3;1H'; row=3
}

draw() {  # draw <attempt> <message>
  bars Enter Unlock Ctrl+Alt+Del Restart
  gap
  say "$B" "The disk can't unlock by itself." 4 "  $A!$R "
  say "$D" "De schijf kan niet vanzelf ontgrendelen. Le disque ne peut pas se déverrouiller seul."
  gap
  say "$D" "This happens after a BIOS or firmware update, a Secure Boot change, or when the disk is moved to another machine."
  gap
  say "$B" "Enter the recovery key from the sheet you kept at installation. Dashes are optional."
  say "$D" "Typ de herstelsleutel van het blad dat u bij de installatie bewaarde."
  say "$D" "Tapez la clé de récupération de la feuille conservée à l'installation."
  gap
  width=$(( cols - 10 < 71 ? cols - 10 : 71 ))
  field=$row
  printf '  %s[%s %s%-*s%s %s]%s\n' "$A" "$R" "$F" "$width" "" "$R" "$A" "$R"; row=$((row + 1))
  say "$D" "Attempt $1 of $TRIES. The key uses only letters that sit in the same place on AZERTY and QWERTY."
  [ -n "$2" ] && say "$A" "$2" 4 "  $A!$R "
  gap
  say "$D" "After unlocking, the appliance links the disk to this machine's TPM again, so the next start is unattended."
  gap
  say "$D" "Lost the key? The data on this disk can't be read without it. Install a fresh appliance and restore the latest backup."
  # Back to the input field, after "[ ".
  printf '\e[%d;5H%s' "$field" "$F"
}

read_key() {  # the typed key, shown as dots, into $typed
  typed=""
  stty -echo -icanon min 1 time 0 2>/dev/null
  while IFS= read -r -s -n 1 ch; do
    case "$ch" in
      ""|$'\n'|$'\r') break ;;
      $'\x7f'|$'\b') [ -n "$typed" ] && { typed=${typed%?}; printf '\b \b'; } ;;
      *) [ ${#typed} -lt 80 ] && { typed+=$ch; printf '•'; } ;;
    esac
  done
  printf '%s' "$R"
  stty sane 2>/dev/null
}

normalise() {  # dashes, spaces and capitals are optional: back to systemd's form, 8 groups of 8
  local k
  k=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d ' -')
  if [[ $k =~ $MODHEX ]]; then
    printf '%s-%s-%s-%s-%s-%s-%s-%s' "${k:0:8}" "${k:8:8}" "${k:16:8}" "${k:24:8}" "${k:32:8}" "${k:40:8}" "${k:48:8}" "${k:56:8}"
  else
    printf '%s' "$1"
  fi
}

message=""
for ((attempt = 1; attempt <= TRIES; attempt++)); do
  draw "$attempt" "$message"
  read_key
  printf '\e[%d;3H%sChecking the key…%s\e[K' $((field + 1)) "$D" "$R"
  normalise "$typed" > "$KEY"
  if /usr/lib/systemd/systemd-cryptsetup attach "$NAME" "$DATA" "$KEY" headless=true >/dev/null 2>&1; then
    printf '\e[2J\e[H\n  %s√%s %sThe disk is unlocked.%s\n' "$T" "$R" "$B" "$R"
    if [ -e /dev/tpmrm0 ]; then
      printf '  %sLinking it to this machine'"'"'s TPM again…%s\n' "$D" "$R"
      # The old TPM's slot goes first, in a step of its own: enrolling with --wipe-slot=tpm2 does nothing
      # when a slot for the same PCRs is there already ("already enrolled"), even one this TPM can't open.
      if systemd-cryptenroll --unlock-key-file="$KEY" --wipe-slot=tpm2 "$DATA" >/dev/null 2>&1 &&
          systemd-cryptenroll --unlock-key-file="$KEY" --tpm2-device=auto --tpm2-pcrs=7 --tpm2-pcrlock= \
            "$DATA" >/dev/null 2>&1; then
        echo tpm-again > /run/suveryn/tpm-enrolled
        printf '  %s√%s The next start is unattended.\n' "$T" "$R"
      else
        printf '  %s!%s The TPM couldn'"'"'t be linked again: the recovery key will be asked at the next start too.\n' "$A" "$R"
      fi
    fi
    rm -f "$KEY"
    echo recovery-key > /run/suveryn/unlocked-by
    sleep 2
    exit 0
  fi
  rm -f "$KEY"
  message="That key doesn't open this disk. Check it against the sheet and try again."
done

# Five wrong keys: say so, and wait. Nothing else starts.
bars Ctrl+Alt+Del Restart
gap
say "$B" "The disk couldn't be unlocked: $TRIES wrong keys." 4 "  $A!$R "
say "$D" "De schijf kon niet worden ontgrendeld. Le disque n'a pas pu être déverrouillé."
gap
say "$B" "Press Ctrl+Alt+Del to restart and try again with the recovery key."
say "$D" "Lost the key? The data on this disk can't be read without it. Install a fresh appliance and restore the latest backup."
echo "suveryn: the data partition couldn't be unlocked (${TRIES} wrong recovery keys)" > /dev/kmsg 2>/dev/null
trap - EXIT
stty sane 2>/dev/null
while :; do sleep 3600; done
