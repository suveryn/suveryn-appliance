# Starts provisioning when the web setup asks for it (suveryn-setup serve writes answers/start).
[Unit]
Description=sūveryn web setup: provisioning requested
ConditionPathExists=!/etc/suveryn/setup-complete
# Not on the installer stick (image/mkosi): there /var is in memory.
ConditionPathExists=!/run/suveryn/installer-mode

[Path]
PathExists=/var/lib/suveryn/setup/answers/start
# Restoring a backup on a replacement machine (#56): first the check, then the restore.
PathExists=/var/lib/suveryn/setup/answers/restore-check
PathExists=/var/lib/suveryn/setup/answers/restore-start
Unit=suveryn-setup-provision.service

[Install]
WantedBy=multi-user.target
