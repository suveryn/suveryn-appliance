class Refused(Exception):
    """An answer the appliance won't take: codes by field (`_` for the whole step)."""

    def __init__(self, codes: dict[str, str]):
        super().__init__(", ".join(f"{k}: {v}" for k, v in codes.items()))
        self.codes = codes


# ---------------------------------------------------------------------------- files
def write_file(path: Path, data: bytes | str, mode: int = 0o600) -> None:
    """Through a new file and a rename: a link someone left at `path` is replaced, never followed."""
    data = data.encode() if isinstance(data, str) else data
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, data)
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def read_file(path: Path, limit: int = MAX_BODY) -> bytes | None:
    """A regular file's bytes, never through a link and never more than `limit`; None if absent."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            raise ValueError(f"{path} isn't a regular file of at most {limit} bytes")
        return os.read(fd, limit + 1)[:limit]
    finally:
        os.close(fd)


def read_json(path: Path, default=None):
    raw = read_file(path)
    if raw is None:
        return default
    try:
        return json.loads(raw)
    except ValueError:
        return default


def remove(path: Path) -> None:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------- the appliance's facts
def run(*cmd, input: bytes | None = None, timeout: float = 30) -> tuple[int, str]:
    try:
        r = subprocess.run([str(c) for c in cmd], input=input, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)
    return r.returncode, r.stdout.decode(errors="replace") or (r.stderr.decode(errors="replace") if r.returncode else "")


def gather_facts() -> dict:
    """What prepare (root) knows that serve can't read: the identity and the installation's record."""
    installed = read_json(VAR / "installed.json", {}) or {}
    identity = read_json(VAR / "identity" / "identity.json", {}) or {}
    name = (read_file(VAR / "host" / "hostname") or b"").decode().strip() or installed.get("name") or socket.gethostname()
    models = [m.get("name") for m in installed.get("models", []) if m.get("name")]
    if not models:  # an appliance from the Packer image: the LLMs in suveryn-core's manifest
        core = read_json(Path(ENV("SUVERYN_CORE_MANIFEST", "/opt/suveryn/core/models/manifest.json")), {}) or {}
        models = [m.get("name") or m.get("id") for m in core.get("models", []) if m.get("role") == "llm"]
    language = installed.get("language") if installed.get("language") in ("en", "nl", "fr") else None
    appliance = ({"id": identity["uuid"], "fingerprint": identity["fingerprint"]}
                 if identity.get("uuid") and identity.get("fingerprint") else None)
    return {"name": name.split(".")[0], "language": language, "appliance": appliance, "models": models}


def network() -> dict:
    """The address, gateway and resolver in use now, as the network screen shows them."""
    out = {"address": "", "dhcp": True, "gateway": "", "dns": ""}
    code, text = run("ip", "-j", "-4", "addr", "show", "scope", "global")
    if code != 0:
        print(f"suveryn-setup: ip addr failed ({code}): {text.strip()[:200]}", file=sys.stderr, flush=True)
    try:
        for link in json.loads(text) if code == 0 else []:
            for a in link.get("addr_info", []):
                if a.get("family") == "inet" and not out["address"]:
                    out["address"] = f"{a['local']}/{a['prefixlen']}"
                    out["dhcp"] = bool(a.get("dynamic"))
    except (ValueError, KeyError, TypeError):
        pass
    code, text = run("ip", "-j", "-4", "route", "show", "default")
    try:
        routes = json.loads(text) if code == 0 else []
        out["gateway"] = routes[0].get("gateway", "") if routes else ""
    except (ValueError, IndexError, AttributeError):
        pass
    for conf in ("/run/systemd/resolve/resolv.conf", "/etc/resolv.conf"):
        servers = re.findall(r"^nameserver\s+(\S+)", (read_file(Path(conf)) or b"").decode(), re.M)
        servers = [s for s in servers if not s.startswith("127.")]
        if servers:
            out["dns"] = ", ".join(servers[:2])
            break
    return out


def usb_disks() -> list[dict]:
    """Whole disks on USB: where a backup could go. Identified by model and serial, like /dev/disk/by-id."""
    code, text = run("lsblk", "-J", "-b", "-d", "-o", "NAME,SIZE,TRAN,TYPE,VENDOR,MODEL,SERIAL")
    disks = []
    try:
        for d in json.loads(text).get("blockdevices", []) if code == 0 else []:
            if d.get("tran") != "usb" or d.get("type") != "disk" or not d.get("size"):
                continue
            model = " ".join((d.get("model") or "").split())
            vendor = " ".join((d.get("vendor") or "").split())
            ident = re.sub(r"[^A-Za-z0-9._-]+", "_", f"usb-{model or vendor or 'disk'}_{d.get('serial') or d['name']}")
            name = model if vendor and model.lower().startswith(vendor.lower()) else f"{vendor} {model}".strip()
            disks.append({"id": ident, "name": name or d["name"], "size_bytes": int(d["size"]), "bus": "USB"})
    except (ValueError, KeyError, TypeError, AttributeError):
        pass
    return disks


# ---------------------------------------------------------------------------- the checks (the screens' rules)
def is_common_password(password: str) -> bool:
    p = password.lower()
    if p in COMMON_PASSWORDS or re.fullmatch(r"(.)\1+", p, re.S):
        return True
    codes = [ord(c) for c in p]
    return all(i == 0 or c - codes[i - 1] == 1 for i, c in enumerate(codes))


def personal_words(*values: str) -> list[str]:
    return [w for v in values for w in re.split(r"[\W_]+", v.lower()) if len(w) >= 4]


def check_network(a) -> dict:
    if not isinstance(a, dict) or a.get("mode") not in ("connected", "air-gapped") or a.get("outgoing") not in ("approved", "all"):
        raise Refused({"_": "invalid"})
    return {"mode": a["mode"], "outgoing": a["outgoing"] if a["mode"] == "connected" else "approved"}


def check_administrator(a, appliance_name: str) -> dict:
    if not isinstance(a, dict) or not all(isinstance(a.get(k), str) for k in ("name", "email", "password")):
        raise Refused({"_": "invalid"})
    name, email, password = " ".join(a["name"].split()), a["email"].strip(), a["password"]
    errors = {}
    if not name or len(name) > 200:
        errors["name"] = "name_missing"
    if len(email) > 254 or not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", email):
        errors["email"] = "email_invalid"
    if len(password) < MIN_PASSWORD or len(password) > 512:
        errors["password"] = "password_short"
    elif is_common_password(password):
        errors["password"] = "password_common"
    elif any(w in password.lower() for w in personal_words(name, email.split("@")[0], appliance_name)):
        errors["password"] = "password_personal"
    if errors:
        raise Refused(errors)
    return {"name": name, "email": email, "password": password}


def pem_blocks(text: str, kind: str) -> list[str]:
    return re.findall(rf"-----BEGIN {kind}-----\r?\n[A-Za-z0-9+/=\r\n]+-----END {kind}-----", text)


def openssl(*args: str, files: dict[str, bytes] | None = None) -> tuple[int, str]:
    """openssl with each input in an anonymous memory file: an argument "@name" is files[name] as
    /dev/fd/N. Nothing the office uploads is written to disk."""
    fds, paths = [], {}
    try:
        for key, content in (files or {}).items():
            fd = os.memfd_create(f"suveryn-setup-{key}")
            os.write(fd, content)
            os.lseek(fd, 0, os.SEEK_SET)
            fds.append(fd)
            paths[key] = f"/dev/fd/{fd}"
        cmd = ["openssl", *[paths[a[1:]] if a.startswith("@") else a for a in args]]
        r = subprocess.run(cmd, capture_output=True, pass_fds=fds, timeout=30, stdin=subprocess.DEVNULL)
        return r.returncode, r.stdout.decode(errors="replace")
    finally:
        for fd in fds:
            os.close(fd)


def certificate_facts(pem: bytes) -> dict | None:
    code, out = openssl("x509", "-in", "@c", "-noout", "-issuer", "-enddate", "-ext", "subjectAltName",
                        "-nameopt", "multiline,utf8", files={"c": pem})
    if code != 0:
        return None
    end = re.search(r"notAfter=(.+)", out)
    issuer_block = out.split("notAfter=")[0]
    cn = re.search(r"commonName\s*=\s*(.+)", issuer_block) or re.search(r"organizationName\s*=\s*(.+)", issuer_block)
    names = re.findall(r"DNS:([^,\s]+)", out) + re.findall(r"IP Address:([^,\s]+)", out)
    not_after = datetime.datetime.strptime(end.group(1).strip(), "%b %d %H:%M:%S %Y %Z") if end else None
    return {"issuer": cn.group(1).strip() if cn else "", "names": names,
            "not_after": not_after.date().isoformat() if not_after else ""}


def covers(names: list[str], host: str) -> bool:
    host = host.lower()
    for n in (n.lower() for n in names):
        if n == host or (n.startswith("*.") and "." in host and host.split(".", 1)[1] == n[2:]):
            return True
    return False


def check_certificate(a, host: str) -> tuple[dict, dict[str, bytes]]:
    """The answer to show and save, and the PEM files to keep (own certificate only)."""
    if not isinstance(a, dict) or a.get("kind") not in ("self-signed", "own"):
        raise Refused({"_": "invalid"})
    if a["kind"] == "self-signed":
        return {"kind": "self-signed", "names": [host, *([ip] if (ip := network()["address"].split("/")[0]) else [])]}, {}
    errors = {}
    texts = {}
    for field, kind in (("certificate", "CERTIFICATE"), ("key", None), ("chain", "CERTIFICATE")):
        value = a.get(field)
        if field == "chain" and not value:
            continue
        if not isinstance(value, str) or len(value.encode()) > MAX_PEM:
            errors[field] = "not_a_certificate" if kind else "not_a_key"
            continue
        texts[field] = value
    cert_blocks = pem_blocks(texts.get("certificate", ""), "CERTIFICATE")
    if "certificate" in texts and len(cert_blocks) < 1:
        errors["certificate"] = "not_a_certificate"
    key_block = re.search(r"-----BEGIN (RSA |EC )?PRIVATE KEY-----\r?\n[A-Za-z0-9+/=\r\n]+-----END (RSA |EC )?PRIVATE KEY-----",
                          texts.get("key", ""))
    if "key" in texts and not key_block:
        errors["key"] = "not_a_key"
    chain_blocks = pem_blocks(texts.get("chain", ""), "CERTIFICATE")
    if texts.get("chain") and not chain_blocks:
        errors["chain"] = "not_a_certificate"
    if errors:
        raise Refused(errors)
    # The first certificate is the appliance's; any others in the same file are its chain.
    leaf = cert_blocks[0].encode() + b"\n"
    chain = "".join(b + "\n" for b in [*cert_blocks[1:], *chain_blocks]).encode()
    key = key_block.group(0).encode() + b"\n"
    facts = certificate_facts(leaf)
    if facts is None:
        raise Refused({"certificate": "not_a_certificate"})
    code, key_pub = openssl("pkey", "-in", "@k", "-passin", "pass:", "-pubout", files={"k": key})
    if code != 0:
        raise Refused({"key": "not_a_key"})
    _, cert_pub = openssl("x509", "-in", "@c", "-noout", "-pubkey", files={"c": leaf})
    if key_pub.strip() != cert_pub.strip():
        raise Refused({"key": "key_mismatch"})
    if openssl("x509", "-in", "@c", "-noout", "-checkend", "0", files={"c": leaf})[0] != 0:
        raise Refused({"certificate": "expired"})
    if not covers(facts["names"], host):
        raise Refused({"certificate": "name_not_covered"})
    if chain:
        code, _ = openssl("verify", "-partial_chain", "-CAfile", "@ch", "@c", files={"ch": chain, "c": leaf})
        if code != 0:
            raise Refused({"chain": "chain_invalid"})
    answer = {"kind": "own", "names": facts["names"], "issuer": facts["issuer"], "not_after": facts["not_after"]}
    return answer, {"certificate.pem": leaf + chain, "key.pem": key}


BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def bech32_valid(s: str, hrp: str) -> bool:
    """A bech32 string (BIP 173) with this human-readable part: age's recipient format."""
    if s != s.lower() or not s.startswith(hrp + "1") or any(c not in BECH32 for c in s[len(hrp) + 1:]):
        return False
    data = [BECH32.index(c) for c in s[len(hrp) + 1:]]
    chk = 1
    for v in [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp] + data:
        top = chk >> 25
        chk = (chk & 0x1ffffff) << 5 ^ v
        for i, g in enumerate((0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3)):
            chk ^= g if (top >> i) & 1 else 0
    return chk == 1


SMB = re.compile(r"(?:\\\\|//)([A-Za-z0-9.-]+|\[[0-9a-fA-F:]+\])[\\/][^\s\\/][^\s]*")
NFS = re.compile(r"([A-Za-z0-9.-]+|\[[0-9a-fA-F:]+\]):(/[^\s]*)")


def share_host(protocol, address) -> str | None:
    if protocol not in ("smb", "nfs") or not isinstance(address, str) or len(address) > 512:
        return None
    m = (SMB if protocol == "smb" else NFS).fullmatch(address.strip())
    return m.group(1).strip("[]") if m else None


def test_share(a) -> dict:
    """Whether the appliance can reach the share's server on the office's network. Reachability only:
    signing in and writing a test file need the backup service's mount (tracker #33)."""
    if not isinstance(a, dict):
        raise Refused({"_": "invalid"})
    host = share_host(a.get("protocol"), a.get("address"))
    if host is None:
        return {"ok": False, "error": "address"}
    try:
        infos = socket.getaddrinfo(host, 445 if a["protocol"] == "smb" else 2049, type=socket.SOCK_STREAM)
    except (socket.gaierror, UnicodeError):
        return {"ok": False, "error": "unreachable"}
    for family, kind, proto, _, addr in infos:
        ip = ipaddress.ip_address(addr[0])
        if not (ip.is_private or ip.is_link_local) or ip.is_loopback:
            return {"ok": False, "error": "not_local"}
    for family, kind, proto, _, addr in infos:
        try:
            with socket.socket(family, kind, proto) as s:
                s.settimeout(SHARE_TIMEOUT)
                s.connect(addr)
                return {"ok": True}
        except OSError:
            continue
    return {"ok": False, "error": "unreachable"}


def check_backups(a, disks: list[dict] | None = None) -> tuple[dict, str | None]:
    """The answer to save and, for a share, its password (kept apart, 0600)."""
    if not isinstance(a, dict) or a.get("target") not in ("usb", "share", "later"):
        raise Refused({"_": "invalid"})
    if a["target"] == "later":
        return {"target": "later"}, None
    if a.get("retention_days") not in RETENTION or not isinstance(a.get("recipient"), str) \
            or not bech32_valid(a["recipient"], "age") or len(a["recipient"]) != 62:
        raise Refused({"_": "invalid"})
    common = {"retention_days": a["retention_days"], "recipient": a["recipient"]}
    if a["target"] == "usb":
        if not isinstance(a.get("disk"), str) or a["disk"] not in {d["id"] for d in (usb_disks() if disks is None else disks)}:
            raise Refused({"disk": "disk_gone"})
        return {"target": "usb", "disk": a["disk"], **common}, None
    if share_host(a.get("protocol"), a.get("address")) is None:
        raise Refused({"address": "address"})
    user = a.get("user") or None
    password = a.get("password") or None
    if (user is not None and (not isinstance(user, str) or len(user) > 256)) or \
            (password is not None and (not isinstance(password, str) or len(password) > 512)):
        raise Refused({"_": "invalid"})
    return {"target": "share", "protocol": a["protocol"], "address": a["address"].strip(), "user": user, **common}, password


def check_restore(a, disks: list[dict] | None = None) -> tuple[dict, str, str | None]:
    """Where the office's backups are and its recovery key (#56): the answer to save (no secrets), the key,
    and a share's password. The same targets as the Backups step, without a retention or a public key."""
    if not isinstance(a, dict) or a.get("target") not in ("usb", "share"):
        raise Refused({"_": "invalid"})
    key = a.get("key")
    key = key.strip() if isinstance(key, str) else ""
    m = AGE_SECRET.search(key)  # the file setup made holds comments around it
    if not m:
        raise Refused({"key": "key_invalid"})
    if a["target"] == "usb":
        if not isinstance(a.get("disk"), str) or a["disk"] not in {d["id"] for d in (usb_disks() if disks is None else disks)}:
            raise Refused({"disk": "disk_gone"})
        return {"target": "usb", "disk": a["disk"]}, m.group(0), None
    if share_host(a.get("protocol"), a.get("address")) is None:
        raise Refused({"address": "address"})
    user, password = a.get("user") or None, a.get("password") or None
    if (user is not None and (not isinstance(user, str) or len(user) > 256)) or \
            (password is not None and (not isinstance(password, str) or len(password) > 512)):
        raise Refused({"_": "invalid"})
    return {"target": "share", "protocol": a["protocol"], "address": a["address"].strip(), "user": user}, m.group(0), password


def manifest_for_screen(m: dict) -> dict:
    return {k: m[k] for k in ("edition", "appliance_id", "users", "valid_until", "next_check_in", "connectors", "playbooks")}


def check_manifest(raw: bytes, facts: dict) -> dict:
    appliance = (facts.get("appliance") or {}).get("id")
    if not appliance:
        raise Refused({"_": "manifest_other_appliance"})
    try:
        return manifest_for_screen(manifests.check(raw, appliance))
    except manifests.Refused as e:
        raise Refused({"_": e.code}) from None


# ---------------------------------------------------------------------------- progress
def blank_progress() -> dict:
    return {"state": "running", "steps": [{"id": s, "state": "waiting"} for s in STEPS], "outgoing": None}


def progress() -> dict | None:
    """What provisioning reports; a request not yet picked up shows as running, nothing done yet."""
    if (ANSWERS / "start").exists():
        return blank_progress()
    p = read_json(STATE / "progress.json")
    return p if isinstance(p, dict) and p.get("state") in ("running", "done", "failed") else None


def restore_progress() -> dict | None:
    """How far a restore is (#56); a request not yet picked up shows as checking or restoring."""
    if (ANSWERS / "restore-check").exists():
        return {"state": "checking"}
    r = read_json(RESTORE)
    if (ANSWERS / "restore-start").exists() and isinstance(r, dict):
        return {**r, "state": "restoring", "steps": [{"id": s, "state": "waiting"} for s in RESTORE_STEPS]}
    return r if isinstance(r, dict) and r.get("state") in ("checking", "checked", "restoring", "done", "failed") else None


# ---------------------------------------------------------------------------- serve
WRITES = ("PUT answers/network", "PUT answers/administrator", "PUT answers/certificate", "POST manifest",
          "PUT answers/support", "PUT answers/backups", "POST backups/test", "POST provision",
          "PUT answers/restore", "POST restore/start")


class App:
    """The setup API. All state is in files: a restart (or a reload of the page) continues."""

    def __init__(self):
        self.lock = threading.Lock()

    def facts(self) -> dict:
        return read_json(STATE / "facts.json", {}) or {}

    def host(self) -> str:
        return f"{self.facts().get('name', 'suveryn')}.local"

    def answers(self) -> dict:
        return read_json(ANSWERS / "answers.json", {}) or {}

    def save(self, key: str, value) -> None:
        with self.lock:
            a = self.answers()
            a[key] = value
            write_file(ANSWERS / "answers.json", json.dumps(a, indent=1, ensure_ascii=False))

    def locked(self) -> None:
        """Answers can't change once provisioning or a restore has started, unless it failed."""
        p = progress()
        if p and p["state"] in ("running", "done"):
            raise Refused({"_": "provisioning_started"})
        r = restore_progress()
        if r and r["state"] in ("checking", "restoring", "done"):
            raise Refused({"_": "restore_started"})

    def start_restore(self) -> dict:
        """The restore of the backup the check found starts; once started, nothing changes (#56)."""
        with self.lock:
            r = restore_progress()
            if r and r["state"] in ("restoring", "done"):
                return r
            if not r or r["state"] != "checked":
                raise Refused({"_": "not_checked"})
            write_file(ANSWERS / "restore-start", "requested by the web setup\n", 0o644)
            return restore_progress()

    def state(self) -> dict:
        f = self.facts()
        return {"name": f.get("name", ""), **network(), "language": f.get("language"),
                "appliance": f.get("appliance"), "models": f.get("models", []), "usb_disks": usb_disks(),
                "answers": self.answers(), "provisioning": progress(), "restore": restore_progress()}

    def handle(self, method: str, path: str, body: bytes, content_type: str) -> tuple[int, object]:
        route = f"{method} {path}"
        if route == "GET state":
            return 200, self.state()
        if route == "GET restore":
            return 200, restore_progress()
        if route == "GET provision":
            p = progress()
            if p and p["state"] == "done":
                (ANSWERS / "seen-done").touch()  # Complete is on screen: provisioning may close setup now
            return 200, p
        if route not in WRITES:
            return 404, {"error": "not_found"}
        # A body must say what it is (a cross-site form can't send these types without the browser
        # asking first); POST provision and POST restore/start have none.
        if route == "POST manifest" and content_type != "application/octet-stream":
            return 415, {"error": "octet_stream_only"}
        if route != "POST manifest" and (body or route not in ("POST provision", "POST restore/start")) and content_type != "application/json":
            return 415, {"error": "json_only"}
        try:
            data = json.loads(body) if route != "POST manifest" and body else None
        except ValueError:
            return 400, {"error": "invalid_json"}
        if route == "POST backups/test":
            return 200, test_share(data)
        if route == "POST provision":
            return 200, self.start()
        if route == "POST restore/start":
            return 200, self.start_restore()
        self.locked()
        if route == "PUT answers/restore":
            answer, key, password = check_restore(data)
            write_file(ANSWERS / "recovery-key", key + "\n")
            if password:
                write_file(ANSWERS / "restore-share-password", password)
            else:
                remove(ANSWERS / "restore-share-password")
            self.save("restore", answer)
            write_file(ANSWERS / "restore-check", "requested by the web setup\n", 0o644)
            return 202, {"state": "checking"}
        if route == "PUT answers/network":
            self.save("network", check_network(data))
        elif route == "PUT answers/administrator":
            a = check_administrator(data, self.facts().get("name", ""))
            write_file(ANSWERS / "administrator-password", a.pop("password"))
            self.save("administrator", a)
        elif route == "PUT answers/certificate":
            answer, files = check_certificate(data, self.host())
            for name in ("certificate.pem", "key.pem"):
                if name in files:
                    write_file(ANSWERS / name, files[name])
                else:
                    remove(ANSWERS / name)
            self.save("certificate", answer)
            return 200, answer
        elif route == "POST manifest":
            m = check_manifest(body, self.facts())
            write_file(ANSWERS / "manifest.yaml", body)
            self.save("support", m)
            return 200, m
        elif route == "PUT answers/support":
            if not isinstance(data, dict) or data.get("skipped") is not True:
                raise Refused({"_": "invalid"})
            remove(ANSWERS / "manifest.yaml")
            self.save("support", None)
        elif route == "PUT answers/backups":
            answer, password = check_backups(data)
            if password:
                write_file(ANSWERS / "share-password", password)
            else:
                remove(ANSWERS / "share-password")
            self.save("backups", answer)
        return 204, None

    def start(self) -> dict:
        """Provisioning starts, or starts again after a failure; while it runs or once done, nothing changes."""
        with self.lock:
            p = progress()
            if p and p["state"] in ("running", "done"):
                return p
            complete(self.answers(), ANSWERS)  # raises Refused when something is missing
            write_file(ANSWERS / "start", "requested by the web setup\n", 0o644)
            return blank_progress()


def complete(a: dict, folder: Path) -> None:
    missing = [k for k in ("network", "administrator", "certificate", "backups") if k not in a]
    if "support" not in a:
        missing.append("support")
    if "administrator" in a and read_file(folder / "administrator-password") is None:
        missing.append("administrator")
    if missing:
        raise Refused({"_": "not_answered"})


class Handler(BaseHTTPRequestHandler):
    app: App
    server_version = "suveryn-setup"
    sys_version = ""

    def log_message(self, fmt, *args):  # method, path and status only: never a body, never a query
        sys.stderr.write(f"suveryn-setup: {self.command} {self.path.split('?')[0]} {args[1] if len(args) > 1 else ''}\n")

    def send(self, status: int, payload) -> None:
        body = b"" if payload is None and status == 204 else json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(status)
        if status != 204:
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if status != 204:
            self.wfile.write(body)

    def dispatch(self, method: str) -> None:
        path = self.path.split("?")[0]
        if not path.startswith("/setup/v1/"):
            return self.send(404, {"error": "not_found"})
        # Another site in the office's browsers can't drive setup: a request that says where it comes
        # from must come from this appliance's own page.
        origin = self.headers.get("Origin")
        if origin is not None and origin != f"https://{self.headers.get('Host', '')}":
            return self.send(403, {"error": "cross_origin"})
        if self.headers.get("Sec-Fetch-Site") not in (None, "same-origin"):
            return self.send(403, {"error": "cross_origin"})
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY or length < 0:
            return self.send(413, {"error": "too_large"})
        body = self.rfile.read(length) if length else b""
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        try:
            status, payload = self.app.handle(method, path[len("/setup/v1/"):], body, ctype)
        except Refused as e:
            status, payload = 422, ({"error": e.codes["_"]} if list(e.codes) == ["_"] else {"errors": e.codes})
        except Exception as e:  # noqa: BLE001: one failed request never stops setup
            sys.stderr.write(f"suveryn-setup: {method} {path}: {type(e).__name__}\n")
            status, payload = 500, {"error": "unexpected"}
        self.send(status, payload)

    def do_GET(self):
        self.dispatch("GET")

    def do_PUT(self):
        self.dispatch("PUT")

    def do_POST(self):
        self.dispatch("POST")


def serve() -> None:
    if os.geteuid() == 0 and not ENV("SUVERYN_SETUP_TEST"):
        raise SystemExit("suveryn-setup serve: not as root (suveryn-setup.service runs it as suveryn-setup)")
    ANSWERS.mkdir(mode=0o700, exist_ok=True)
    Handler.app = App()
    httpd = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"suveryn-setup: answering the web setup on 127.0.0.1:{PORT} (through nginx)", file=sys.stderr, flush=True)
    httpd.serve_forever()


