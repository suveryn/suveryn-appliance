def provision_module():
    """suveryn-provision's own TLS and nginx steps (always this checkout's, whatever runs provisioning)."""
    return load("suveryn_provision", REPO / "provision" / "suveryn-provision")


def prepare() -> None:
    if SETUP_COMPLETE.exists():
        print("suveryn-setup: setup is complete; nothing to prepare")
        return
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    os.chmod(STATE, 0o755)
    ANSWERS.mkdir(mode=0o700, exist_ok=True)
    try:
        import pwd
        pw = pwd.getpwnam(USER)
        os.chown(ANSWERS, pw.pw_uid, pw.pw_gid)
    except KeyError:
        if not ENV("SUVERYN_SETUP_TEST"):
            raise SystemExit(f"suveryn-setup: no user {USER} (suveryn-provision image creates it)")
    os.chmod(ANSWERS, 0o700)
    facts = gather_facts()
    write_file(STATE / "facts.json", json.dumps(facts, indent=1, ensure_ascii=False), 0o644)
    host = f"{facts['name']}.local"
    ip = network()["address"].split("/")[0]
    p = provision_module()
    # The appliance's own certificate: the local CA's, for <name>.local and the address. Provisioning
    # keeps it when the office chooses it (tls() keeps a certificate that names the host).
    p.tls(host, None, None, ips=[ip] if ip else [])
    shutil.copyfile(ETC / "tls" / "server.crt", SETUP_CERT)
    os.chmod(SETUP_CERT, 0o644)
    nginx_setup_site(host)
    print(f"suveryn-setup: prepared https://{host}/ ({ip or 'no address yet'})", flush=True)


SETUP_SITE_MARK = "# sūveryn web setup site"


def nginx_setup_site(host: str) -> None:
    """While setup is open, nginx serves the setup page and passes /setup/v1/ to serve. Before
    provisioning that is the whole site; provisioning's site includes the same file until setup closes."""
    p = provision_module()
    p.NGINX = NGINX
    p.snippets()
    write_file(NGINX_SETUP, (HERE / "nginx-setup.conf").read_text().replace("@PORT@", str(PORT)), 0o644)
    site = p.site_file()  # sites-available, or on the read-only system the data partition
    if not site.exists() or SETUP_SITE_MARK in site.read_text():
        site.parent.mkdir(parents=True, exist_ok=True)
        write_file(site, (HERE / "nginx-setup-site.conf.template").read_text().replace("@HOST@", host), 0o644)
    enabled = NGINX / "sites-enabled" / "suveryn"
    if not enabled.exists() and not enabled.is_symlink():
        enabled.parent.mkdir(parents=True, exist_ok=True)
        enabled.symlink_to(site)
    if (NGINX / "sites-enabled" / "default").exists():
        remove(NGINX / "sites-enabled" / "default")
    if not ENV("SUVERYN_SETUP_TEST"):
        code, out = run("nginx", "-t")
        if code != 0:
            raise SystemExit(f"suveryn-setup: nginx refuses the setup site: {out[-300:]}")
        p.sites_loaded(SETUP_SITE_MARK if SETUP_SITE_MARK in site.read_text() else f"server_name {host};")
        p.start_nginx()


# ---------------------------------------------------------------------------- provision (root)
class Progress:
    def __init__(self):
        self.p = blank_progress()

    def write(self) -> None:
        write_file(STATE / "progress.json", json.dumps(self.p, indent=1), 0o644)

    def step(self, ident: str, state: str, error: str | None = None) -> None:
        for s in self.p["steps"]:
            if s["id"] == ident:
                s["state"] = state
                if error:
                    s["error"] = error
            elif state == "running" and STEPS.index(s["id"]) < STEPS.index(ident) and s["state"] != "done":
                s["state"] = "done"
        self.write()

    def current(self) -> str:
        return next((s["id"] for s in self.p["steps"] if s["state"] == "running"), "database")

    def fail(self, error: str) -> None:
        self.step(self.current(), "failed", error)
        self.p["state"] = "failed"
        self.write()


def read_answers() -> tuple[dict, dict]:
    """The saved answers, checked again here: they come from the unprivileged service's folder."""
    facts = read_json(STATE / "facts.json", {}) or {}
    a = read_json(ANSWERS / "answers.json", {}) or {}
    complete(a, ANSWERS)
    host = f"{facts.get('name', '')}.local"
    password = (read_file(ANSWERS / "administrator-password", 4096) or b"").decode()
    out = {"network": check_network(a["network"]),
           "administrator": check_administrator({**a["administrator"], "password": password}, facts.get("name", "")),
           # A USB disk unplugged since doesn't stop provisioning: the backup service looks for it later.
           "backups": check_backups(a["backups"], disks=[{"id": a["backups"].get("disk")}])[0],
           "certificate": {"kind": a["certificate"].get("kind")}, "support": None}
    files = {}
    if out["certificate"]["kind"] == "own":
        cert = read_file(ANSWERS / "certificate.pem", 2 * MAX_PEM) or b""
        key = read_file(ANSWERS / "key.pem", MAX_PEM) or b""
        answer, files = check_certificate({"kind": "own", "certificate": cert.decode(), "key": key.decode()}, host)
        out["certificate"] = answer
    elif out["certificate"]["kind"] != "self-signed":
        raise Refused({"certificate": "invalid"})
    raw = read_file(ANSWERS / "manifest.yaml", manifests.MAX_SIZE)
    if a.get("support") is not None and raw is not None:
        out["support"] = check_manifest(raw, facts)
        files["manifest.yaml"] = raw
    password_file = read_file(ANSWERS / "share-password", 4096)
    if password_file:
        files["share-password"] = password_file
    return out, files


def provision() -> int:
    if (ANSWERS / "restore-check").exists():
        return restore_check()
    if (ANSWERS / "restore-start").exists():
        return restore_run()
    if SETUP_COMPLETE.exists():
        remove(ANSWERS / "start")
        return 0
    prog = Progress()
    prog.write()
    remove(ANSWERS / "start")  # after progress.json says running: the screen never sees the old state
    LOGS.mkdir(parents=True, exist_ok=True)
    log = open(LOGS / "setup-provision.log", "a")
    log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} provisioning from the web setup\n")
    try:
        answers, files = read_answers()
    except (Refused, KeyError, TypeError, ValueError, AttributeError) as e:
        log.write(f"the saved answers are incomplete or not valid: {e}\n")
        prog.fail("answers")
        return 1
    facts = read_json(STATE / "facts.json", {}) or {}
    host = f"{facts['name']}.local"
    work = Path(ENV("SUVERYN_SETUP_WORK", "/run/suveryn/setup"))
    work.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(work, 0o700)
    admin_file = work / "administrator.json"
    write_file(admin_file, json.dumps(answers["administrator"]))
    net = answers["network"]
    cmd = [sys.executable, str(PROVISION), "first-boot", "--public-url", f"https://{host}", "--network-mode", net["mode"],
           *(["--outbound", net["outgoing"]] if net["mode"] == "connected" else []), "--site", SITE, *(["--test-machine"] if SITE == "test" else []),
           "--administrator", str(admin_file)]
    models = models_media(work)
    if models:
        cmd += ["--models-from", str(models)]
    prog.step("database", "running")
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
                                stdin=subprocess.DEVNULL)
        lines = {"last": ""}

        def follow():
            for line in proc.stdout:
                log.write(line)
                log.flush()
                if line.startswith("== "):
                    title = line[3:].strip()
                    ui = next((v for k, v in PROVISION_STEPS.items() if title.startswith(k)), None)
                    if ui and STEPS.index(ui) > STEPS.index(prog.current()):
                        prog.step(ui, "running")
                elif line.strip():
                    lines["last"] = line.strip()
        # Until provisioning ends, not until its output closes: a service it starts without systemd (a
        # test container) can keep that output open for as long as the service runs.
        reader = threading.Thread(target=follow, daemon=True)
        reader.start()
        code = proc.wait()
        reader.join(5)
        last = lines["last"]
    finally:
        remove(admin_file)
        if models:
            run("umount", models)
    if code != 0:
        log.write(f"suveryn-provision first-boot failed ({code})\n")
        prog.fail(re.sub(r"[^\w .,:/()'-]", "", last)[:200] or f"exit {code}")
        return 1
    prog.step("outgoing", "running")
    code, out = run(NETWORK_MODE_TOOL, "check", "--json", timeout=120)
    try:
        result = json.loads(out)
    except ValueError:
        result = {"passed": False}
    log.write(f"outgoing-traffic check: {result.get('summary', 'no result')}\n")
    prog.p["outgoing"] = ("not_checked" if net["mode"] == "connected" and net["outgoing"] == "all"
                          else "not_limited" if not result.get("passed")
                          else "blocked" if net["mode"] == "air-gapped" else "limited")
    keep_settings(answers, files)
    prog.step("outgoing", "done")
    prog.p["state"] = "done"
    prog.write()
    log.write("provisioning done; waiting for the browser to show Complete\n")
    log.close()
    deadline = time.time() + SEEN_DONE_WAIT
    while time.time() < deadline and not (ANSWERS / "seen-done").exists():
        time.sleep(1)
    finish(answers, files)
    return 0


# ---------------------------------------------------------------------------- restore (#56)
def restore_inputs(work: Path) -> list[str]:
    """suveryn-backup's options for the office's target and share password, from the saved answer (read
    back as untrusted input: checked again)."""
    a = (read_json(ANSWERS / "answers.json", {}) or {}).get("restore")
    key = read_file(ANSWERS / "recovery-key")
    if not isinstance(a, dict) or key is None:
        raise Refused({"_": "not_answered"})
    password = read_file(ANSWERS / "restore-share-password")
    answer, _, _ = check_restore({**a, "key": key.decode(errors="replace"), "password": password.decode() if password else None},
                                 disks=[{"id": a.get("disk")}])
    write_file(work / "restore-settings.json", json.dumps(answer))
    opts = ["--settings", str(work / "restore-settings.json")]
    if password:
        write_file(work / "restore-share-password", password)
        opts += ["--share-secret", str(work / "restore-share-password")]
    return opts


def restore_work() -> Path:
    work = Path(ENV("SUVERYN_SETUP_WORK", "/run/suveryn/setup"))
    work.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(work, 0o700)
    return work


CHECK_ERRORS = {"decrypt": "wrong_key", "read": "damaged", "check": "damaged", "settings": "invalid", "database": "damaged"}


def forget_restore_secrets(work: Path | None = None) -> None:
    """The recovery key and a share's password are kept for one check or restore only."""
    for f in ("recovery-key", "restore-share-password"):
        remove(ANSWERS / f)
    if work is not None:
        for f in ("restore-settings.json", "restore-share-password"):
            remove(work / f)


def restore_check() -> int:
    """Find the newest backup on the target and check it with the key: what the screen asks to confirm."""
    write_file(RESTORE, json.dumps({"state": "checking"}), 0o644)
    remove(ANSWERS / "restore-check")
    work = restore_work()
    try:
        opts = restore_inputs(work)
    except Refused:
        write_file(RESTORE, json.dumps({"state": "failed", "error": "invalid"}), 0o644)
        forget_restore_secrets(work)
        return 1
    code, out = run(sys.executable, "-I", BACKUP_TOOL, *opts, "check", "newest", "--on-target", "--json",
                    "--identity", ANSWERS / "recovery-key", timeout=1800)
    try:
        r = json.loads(out.strip().splitlines()[-1])
    except (ValueError, IndexError):
        r = {"usable": False, "step": "check"}
    if r.get("usable"):
        result = {"state": "checked", "backup": {"file": r["file"], "created": r["created"], "appliance": r["appliance"]}}
    else:
        error = ("no_backup" if "no backup" in str(r.get("message", "")) else "unreachable") if r.get("step") == "target" \
            else CHECK_ERRORS.get(r.get("step"), "damaged")
        result = {"state": "failed", "error": error}
        forget_restore_secrets()  # the screen asks for them again
    write_file(RESTORE, json.dumps(result, indent=1), 0o644)
    return 0 if r.get("usable") else 1


def restore_run() -> int:
    """Restore the backup the check found (suveryn-provision restore), reporting its steps; then close setup."""
    found = read_json(RESTORE, {}) or {}
    remove(ANSWERS / "restore-start")
    backup = found.get("backup") or {}
    r = {"state": "restoring", "backup": backup, "address": f"https://{backup.get('appliance', '')}.local",
         "steps": [{"id": s, "state": "waiting"} for s in RESTORE_STEPS]}

    def step(ident: str, state: str) -> None:
        for st in r["steps"]:
            if st["id"] == ident:
                st["state"] = state
            elif state == "running" and RESTORE_STEPS.index(st["id"]) < RESTORE_STEPS.index(ident) and st["state"] != "done":
                st["state"] = "done"
        write_file(RESTORE, json.dumps(r, indent=1), 0o644)

    step("database", "running")
    LOGS.mkdir(parents=True, exist_ok=True)
    log = open(LOGS / "setup-restore.log", "a")
    log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} restoring from the web setup: {backup.get('file')}\n")
    work = restore_work()
    try:
        opts = restore_inputs(work)
    except Refused:
        forget_restore_secrets(work)
        r["state"], r["error"] = "failed", "invalid"
        step("database", "failed")
        return 1
    cmd = [sys.executable, str(PROVISION), "restore", *opts, "--identity", str(ANSWERS / "recovery-key"),
           "--backup", backup.get("file") or "newest"]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1, stdin=subprocess.DEVNULL)
    current = "database"
    for line in proc.stdout:
        log.write(line)
        log.flush()
        if line.startswith("== "):
            ident = next((v for k, v in RESTORE_PROVISION_STEPS.items() if line[3:].strip().startswith(k)), None)
            if ident and RESTORE_STEPS.index(ident) > RESTORE_STEPS.index(current):
                current = ident
                step(ident, "running")
    code = proc.wait()
    forget_restore_secrets(work)
    if code != 0:
        log.write(f"suveryn-provision restore failed ({code})\n")
        r["state"], r["error"] = "failed", "restore"
        step(current, "failed")
        return 1
    step("services", "done")
    r["state"] = "done"
    write_file(RESTORE, json.dumps(r, indent=1), 0o644)
    log.write("restored; closing setup\n")
    log.close()
    close_after_restore()
    return 0


def close_after_restore() -> None:
    """The restored office's settings are in place (its setup-complete among them): close the web setup."""
    if not SETUP_COMPLETE.exists():
        write_file(SETUP_COMPLETE, time.strftime("%Y-%m-%dT%H:%M:%SZ\n", time.gmtime()), 0o644)
    remove(NGINX_SETUP)
    remove(SETUP_CERT)
    if not ENV("SUVERYN_SETUP_TEST"):
        provision_module().start_nginx()
    shutil.rmtree(ANSWERS, ignore_errors=True)
    if Path("/run/systemd/system").is_dir() and not ENV("SUVERYN_SETUP_TEST"):
        run("systemctl", "disable", "suveryn-setup.service", "suveryn-setup-provision.path")
        run("systemctl", "stop", "--no-block", "suveryn-setup.service", "suveryn-setup-provision.path")


def models_media(work: Path) -> Path | None:
    """Model files on a USB disk labelled SUVERYN-MODELS (air-gapped), mounted read-only."""
    dev = Path("/dev/disk/by-label/SUVERYN-MODELS")
    if not dev.exists():
        return None
    target = work / "models"
    target.mkdir(exist_ok=True)
    return target if run("mount", "-o", "ro,nosuid,nodev,noexec", dev, target)[0] == 0 else None


def keep_settings(answers: dict, files: dict) -> None:
    """What the office chose that later parts read: the support manifest and the backup settings."""
    if "manifest.yaml" in files:
        (ETC / "support").mkdir(exist_ok=True)
        os.chmod(ETC / "support", 0o755)
        write_file(ETC / "support" / "manifest.yaml", files["manifest.yaml"], 0o644)
    # The backup service (tracker #33) reads this: where, how long, and the public key backups are
    # encrypted to. The share's password is kept apart, readable by root only.
    write_file(ETC / "backups.json", json.dumps(answers["backups"], indent=1), 0o644)
    if "share-password" in files:
        write_file(ETC / "backups-share.secret", files["share-password"], 0o600)


def finish(answers: dict, files: dict) -> None:
    """Close setup: the office's certificate in, the setup locations out, setup-complete written."""
    if "certificate.pem" in files:
        write_file(ETC / "tls" / "server.key", files["key.pem"], 0o600)
        write_file(ETC / "tls" / "server.crt", files["certificate.pem"], 0o644)
        trust_office_ca(files["certificate.pem"])
    remove(NGINX_SETUP)
    if not ENV("SUVERYN_SETUP_TEST"):
        provision_module().start_nginx()
    summary = {"completed": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
               "network": answers["network"],
               "administrator": {k: answers["administrator"][k] for k in ("name", "email")},
               "certificate": answers["certificate"], "support": answers["support"], "backups": answers["backups"]}
    write_file(ETC / "setup-answers.json", json.dumps(summary, indent=1, ensure_ascii=False), 0o644)
    write_file(SETUP_COMPLETE, summary["completed"] + "\n", 0o644)
    remove(SETUP_CERT)
    shutil.rmtree(ANSWERS, ignore_errors=True)  # the password and key files with it
    if Path("/run/systemd/system").is_dir() and not ENV("SUVERYN_SETUP_TEST"):
        # Disabled where /etc can be written; on the read-only system the units' condition
        # (setup-complete) keeps them from starting again, so stopping them is enough.
        if run("systemctl", "disable", "suveryn-setup.service", "suveryn-setup-provision.path")[0] != 0:
            print("suveryn-setup: units not disabled (read-only system); setup-complete keeps them stopped", flush=True)
        run("systemctl", "stop", "--no-block", "suveryn-setup.service", "suveryn-setup-provision.path")


def trust_office_ca(pem: bytes) -> None:
    """The gateway reaches Keycloak at the public https name, so the appliance itself must trust the
    office's certificate: the self-signed (root) certificates the office gave with it join the
    appliance's trust store, as the local CA's does (suveryn-provision tls())."""
    roots = []
    for block in pem_blocks(pem.decode(errors="replace"), "CERTIFICATE"):
        _, subject = openssl("x509", "-in", "@c", "-noout", "-subject", "-nameopt", "RFC2253", files={"c": block.encode()})
        _, issuer = openssl("x509", "-in", "@c", "-noout", "-issuer", "-nameopt", "RFC2253", files={"c": block.encode()})
        if subject.split("=", 1)[-1].strip() == issuer.split("=", 1)[-1].strip():
            roots.append(block)
    if not roots or ENV("SUVERYN_SETUP_TEST"):
        return
    try:
        for i, block in enumerate(roots):
            write_file(Path(f"/usr/local/share/ca-certificates/suveryn-office-ca-{i}.crt"), block + "\n", 0o644)
    except OSError as e:  # the read-only system: the trust bundle on the data partition (#39) takes its place
        print(f"suveryn-setup: the office's CA isn't added to the system's trust store ({e.strerror})", flush=True)
        return
    run("update-ca-certificates")
    if Path("/run/systemd/system").is_dir():
        run("systemctl", "try-restart", "suveryn-gateway.service")


def watch() -> None:
    """Without systemd: provision whenever serve asks for it."""
    while not SETUP_COMPLETE.exists():
        if any((ANSWERS / f).exists() for f in ("start", "restore-check", "restore-start")):
            provision()
        time.sleep(1)


def main(argv: list[str]) -> int:
    commands = {"prepare": prepare, "serve": serve, "provision": provision, "watch": watch}
    if len(argv) != 1 or argv[0] not in commands:
        print("usage: suveryn-setup prepare | serve | provision | watch", file=sys.stderr)
        return 2
    if argv[0] in ("prepare", "provision", "watch") and os.geteuid() != 0 and not ENV("SUVERYN_SETUP_TEST"):
        print(f"suveryn-setup {argv[0]}: run as root", file=sys.stderr)
        return 2
    return commands[argv[0]]() or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
